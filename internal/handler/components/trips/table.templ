package trips

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ Table(result models.TripListResult, filter models.TripFilter) {
	<div class="table-container">
		<table>
			<thead>
				<tr>
					@components.SortHeader("Load #", "load_number", filter.SortBy, filter.SortDir, "/dispatch/trips", "#trip-table")
					@components.SortHeader("Truck", "truck_number", filter.SortBy, filter.SortDir, "/dispatch/trips", "#trip-table")
					@components.SortHeader("Driver", "driver", filter.SortBy, filter.SortDir, "/dispatch/trips", "#trip-table")
					@components.SortHeader("Trip Date", "trip_date", filter.SortBy, filter.SortDir, "/dispatch/trips", "#trip-table")
					<th>Zone</th>
					@components.SortHeader("Status", "status", filter.SortBy, filter.SortDir, "/dispatch/trips", "#trip-table")
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				if len(result.Items) > 0 {
					for _, t := range result.Items {
						<tr>
							<td><a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d", t.ID)) }>{ t.LoadNumber }</a></td>
							<td>{ components.Deref(t.TruckNumber) }</td>
							<td>{ components.Deref(t.Driver) }</td>
							<td>
								if t.TripDate != nil {
									{ t.TripDate.Format("01/02/2006") }
								}
							</td>
							<td>{ components.Deref(t.Zone) }</td>
							<td>
								if !t.Active {
									<span class="badge badge-inactive">Inactive</span>
								} else {
									<span class="badge badge-active">Active</span>
								}
							</td>
							<td class="text-right">
								<div class="btn-group">
									<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d", t.ID)) } class="btn btn-sm">View</a>
									<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d/edit", t.ID)) } class="btn btn-sm">Edit</a>
									<button
										class="btn btn-sm btn-danger"
										hx-delete={ fmt.Sprintf("/dispatch/trips/%d", t.ID) }
										hx-confirm={ fmt.Sprintf("Delete trip %s?", t.LoadNumber) }
									>Delete</button>
								</div>
							</td>
						</tr>
					}
				} else {
					<tr><td colspan="7" class="text-center text-muted">No trips found</td></tr>
				}
			</tbody>
		</table>
	</div>
	if len(result.Items) > 0 {
		@components.Pagination(components.NewPaginationData(
			result.Page, result.PageSize, result.TotalCount,
			"/dispatch/trips", "#trip-table",
		))
	}
}
