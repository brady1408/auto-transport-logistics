package trips

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ RouteTable(routes []models.TripRoute, tripID int) {
	<div class="table-container">
		<table>
			<thead>
				<tr>
					<th>Seq</th>
					<th>Customer</th>
					<th>City</th>
					<th>State</th>
					<th>Stop Type</th>
					<th>Miles</th>
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				if len(routes) > 0 {
					for _, rt := range routes {
						<tr>
							<td>{ fmt.Sprintf("%d", components.DerefInt(rt.Sequence)) }</td>
							<td>{ components.Deref(rt.CustomerName) }</td>
							<td>{ components.Deref(rt.City) }</td>
							<td>{ components.Deref(rt.State) }</td>
							<td>{ components.Deref(rt.StopType) }</td>
							<td>{ fmt.Sprintf("%d", components.DerefInt(rt.Miles)) }</td>
							<td class="text-right">
								<button
									class="btn btn-sm btn-danger"
									hx-delete={ fmt.Sprintf("/dispatch/routes/%d", rt.ID) }
									hx-target="#route-table"
									hx-confirm="Delete this route stop?"
								>Delete</button>
							</td>
						</tr>
					}
				} else {
					<tr><td colspan="7" class="text-center text-muted">No route stops</td></tr>
				}
			</tbody>
		</table>
	</div>
	if tripID > 0 {
		<form
			class="inline-form mt-2"
			hx-post={ fmt.Sprintf("/dispatch/trips/%d/routes", tripID) }
			hx-target="#route-table"
			hx-swap="innerHTML"
		>
			<input type="number" name="sequence" class="form-control" placeholder="Seq" style="width:60px"/>
			<input type="text" name="customer_name" class="form-control" placeholder="Customer" style="min-width:150px"/>
			<input type="text" name="city" class="form-control" placeholder="City" style="width:120px"/>
			<input type="text" name="state" class="form-control" placeholder="ST" maxlength="2" style="width:50px;text-transform:uppercase"/>
			<input type="text" name="stop_type" class="form-control" placeholder="Type" style="width:80px"/>
			<input type="number" name="miles" class="form-control" placeholder="Miles" style="width:80px"/>
			<button type="submit" class="btn btn-sm btn-primary">Add</button>
		</form>
	}
}
