package trips

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ FormPage(pg components.PageContext, trip *models.Trip, isNew bool, errMsg string) {
	@components.Layout(pg, tripFormTitle(isNew, trip) + " - ATLinks") {
		<div class="page-header">
			<h1>
				if isNew {
					New Trip
				} else {
					Edit Trip: { trip.LoadNumber }
				}
			</h1>
			<a href="/dispatch/trips" class="btn">Back to List</a>
		</div>
		if errMsg != "" {
			<div class="alert alert-danger">{ errMsg }</div>
		}
		<form
			method="POST"
			if isNew {
				action="/dispatch/trips"
				hx-post="/dispatch/trips"
			} else {
				action={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d/edit", trip.ID)) }
				hx-put={ fmt.Sprintf("/dispatch/trips/%d", trip.ID) }
			}
		>
			@components.CSRFField(pg.CSRFToken)
			<input type="hidden" name="version" value={ fmt.Sprintf("%d", trip.Version) }/>
			<fieldset>
				<legend>Trip Information</legend>
				<div class="form-row">
					<div class="form-group">
						<label for="load_number">Load Number</label>
						<input
							type="text" id="load_number" name="load_number" class="form-control"
							value={ trip.LoadNumber }
							if !isNew {
								readonly
							}
						/>
					</div>
					<div class="form-group">
						<label for="truck_number">Truck Number</label>
						<input type="text" id="truck_number" name="truck_number" class="form-control" value={ components.Deref(trip.TruckNumber) } maxlength="10"/>
					</div>
					<div class="form-group">
						<label for="trailer_number">Trailer Number</label>
						<input type="text" id="trailer_number" name="trailer_number" class="form-control" value={ components.Deref(trip.TrailerNumber) } maxlength="4"/>
					</div>
					<div class="form-group">
						<label for="zone">Zone</label>
						<input type="text" id="zone" name="zone" class="form-control" value={ components.Deref(trip.Zone) } maxlength="20"/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="driver">Driver</label>
						<input type="text" id="driver" name="driver" class="form-control" value={ components.Deref(trip.Driver) } maxlength="30"/>
					</div>
					<div class="form-group">
						<label for="driver2">Driver 2</label>
						<input type="text" id="driver2" name="driver2" class="form-control" value={ components.Deref(trip.Driver2) } maxlength="30"/>
					</div>
					<div class="form-group">
						<label for="equipment_type">Equipment Type</label>
						<input type="text" id="equipment_type" name="equipment_type" class="form-control" value={ components.Deref(trip.EquipmentType) } maxlength="10"/>
					</div>
					<div class="form-check form-check-aligned">
						<input type="checkbox" id="inactive" name="inactive" checked?={ !trip.Active }/>
						<label for="inactive">Inactive</label>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Dates</legend>
				<div class="form-row">
					<div class="form-group">
						<label for="trip_date">Trip Date</label>
						<input type="date" id="trip_date" name="trip_date" class="form-control" value={ components.FormatDate(trip.TripDate) }/>
					</div>
					<div class="form-group">
						<label for="est_deliver_date">Est. Deliver Date</label>
						<input type="date" id="est_deliver_date" name="est_deliver_date" class="form-control" value={ components.FormatDate(trip.EstDeliverDate) }/>
					</div>
					<div class="form-group">
						<label for="deliver_date">Deliver Date</label>
						<input type="date" id="deliver_date" name="deliver_date" class="form-control" value={ components.FormatDate(trip.DeliverDate) }/>
					</div>
					<div class="form-group">
						<label for="return_date">Return Date</label>
						<input type="date" id="return_date" name="return_date" class="form-control" value={ components.FormatDate(trip.ReturnDate) }/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Rates &amp; Advances</legend>
				<div class="form-row">
					<div class="form-group">
						<label for="driver_rate">Driver Rate</label>
						<input type="text" id="driver_rate" name="driver_rate" class="form-control" value={ components.Deref(trip.DriverRate) }/>
					</div>
					<div class="form-group">
						<label for="driver_calc_type">Calc Type</label>
						<input type="text" id="driver_calc_type" name="driver_calc_type" class="form-control" value={ components.Deref(trip.DriverCalcType) } maxlength="10"/>
					</div>
					<div class="form-group">
						<label for="truck_rate">Truck Rate</label>
						<input type="text" id="truck_rate" name="truck_rate" class="form-control" value={ components.Deref(trip.TruckRate) }/>
					</div>
					<div class="form-group">
						<label for="truck_calc_type">Truck Calc Type</label>
						<input type="text" id="truck_calc_type" name="truck_calc_type" class="form-control" value={ components.Deref(trip.TruckCalcType) } maxlength="10"/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="fuel_advance">Fuel Advance</label>
						<input type="text" id="fuel_advance" name="fuel_advance" class="form-control" value={ components.Deref(trip.FuelAdvance) }/>
					</div>
					<div class="form-group">
						<label for="trip_advance">Trip Advance</label>
						<input type="text" id="trip_advance" name="trip_advance" class="form-control" value={ components.Deref(trip.TripAdvance) }/>
					</div>
					<div class="form-group">
						<label for="tolls_advance">Tolls Advance</label>
						<input type="text" id="tolls_advance" name="tolls_advance" class="form-control" value={ components.Deref(trip.TollsAdvance) }/>
					</div>
					<div class="form-group">
						<label for="total_mileage">Total Mileage</label>
						<input type="number" id="total_mileage" name="total_mileage" class="form-control" value={ fmt.Sprintf("%d", components.DerefInt(trip.TotalMileage)) }/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Comments</legend>
				<div class="form-group">
					<textarea id="comments" name="comments" class="form-control">{ components.Deref(trip.Comments) }</textarea>
				</div>
			</fieldset>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					if isNew {
						Create Trip
					} else {
						Save Changes
					}
				</button>
				<a href="/dispatch/trips" class="btn">Cancel</a>
			</div>
		</form>
	}
}

func tripFormTitle(isNew bool, trip *models.Trip) string {
	if isNew {
		return "New Trip"
	}
	return "Edit Trip: " + trip.LoadNumber
}
