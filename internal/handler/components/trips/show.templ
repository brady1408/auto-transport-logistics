package trips

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/handler/components/attachments"
	"github.com/brady1408/atlinks/internal/models"
	"github.com/brady1408/atlinks/internal/store"
)

templ ShowPage(pg components.PageContext, trip *models.Trip, loads []store.LoadDetailWithOrder, vehicleCount int, atts []models.Attachment) {
	@components.Layout(pg, "Trip " + trip.LoadNumber + " - ATLinks") {
		<div class="page-header">
			<div>
				<a href="/dispatch/trips" class="page-header-back">← Back to List</a>
				<h1>Trip { trip.LoadNumber }</h1>
			</div>
			<div class="btn-group">
				<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d/edit", trip.ID)) } class="btn">Edit Trip</a>
			</div>
		</div>
		<div class="order-detail-grid">
			<div class="card">
				<div class="card-header">Trip Info</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Status:</span>
						<span>
							if trip.Active {
								<span class="badge badge-active">Active</span>
							} else {
								<span class="badge badge-inactive">Inactive</span>
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Truck:</span>
						<span>{ components.Deref(trip.TruckNumber) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Trailer:</span>
						<span>{ components.Deref(trip.TrailerNumber) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Driver 1:</span>
						<span>{ components.Deref(trip.Driver) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Driver 2:</span>
						<span>{ components.Deref(trip.Driver2) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Trip Date:</span>
						<span>
							if trip.TripDate != nil {
								{ trip.TripDate.Format("01/02/2006") }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Est. Delivery:</span>
						<span>
							if trip.EstDeliverDate != nil {
								{ trip.EstDeliverDate.Format("01/02/2006") }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Deliver Date:</span>
						<span>
							if trip.DeliverDate != nil {
								{ trip.DeliverDate.Format("01/02/2006") }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Zone:</span>
						<span>{ components.Deref(trip.Zone) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Equipment:</span>
						<span>{ components.Deref(trip.EquipmentType) }</span>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">Trip Summary</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Vehicles:</span>
						<span><strong>{ fmt.Sprintf("%d", vehicleCount) }</strong></span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Driver Rate:</span>
						<span>{ components.Deref(trip.DriverRate) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Driver Calc:</span>
						<span>{ components.Deref(trip.DriverCalcType) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Mileage:</span>
						<span>
							if trip.TotalMileage != nil {
								{ fmt.Sprintf("%d", components.DerefInt(trip.TotalMileage)) }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Fuel Advance:</span>
						<span>{ components.Deref(trip.FuelAdvance) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Trip Advance:</span>
						<span>{ components.Deref(trip.TripAdvance) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Comments:</span>
						<span>{ components.Deref(trip.Comments) }</span>
					</div>
				</div>
			</div>
		</div>
		<div x-data="{ showModal: false }" { escapeKeyAttr()... }>
			<div style="display:flex;align-items:center;justify-content:space-between">
				<h2 class="section-title" style="margin-bottom:0;flex:1">Load Manifest ({ fmt.Sprintf("%d", vehicleCount) } vehicles)</h2>
				<button class="btn btn-primary btn-sm" { showModalAttr()... } style="margin-top:18px">Add Vehicles</button>
			</div>
			<div
				id="load-manifest"
				hx-get={ fmt.Sprintf("/dispatch/trips/%d/loads", trip.ID) }
				hx-trigger="vehicle-assigned from:body"
				hx-swap="innerHTML"
				style="margin-top:12px"
			>
				@LoadTable(loads, trip.ID)
			</div>
			<!-- Available Vehicles Modal -->
			<div
				x-show="showModal" x-cloak class="modal-backdrop"
				{ modalBackdropAttrs()... }
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
			>
				<div class="modal-dialog" { stopClickAttr()... }>
					<div class="modal-header">
						<h3>Add Vehicles to Trip { trip.LoadNumber }</h3>
						<button class="modal-close" { closeModalAttr()... }>&times;</button>
					</div>
					<div class="modal-body">
						<div
							id="modal-vehicle-list"
							hx-get={ fmt.Sprintf("/dispatch/trips/%d/available-vehicles", trip.ID) }
							hx-trigger="intersect once, vehicle-assigned from:body"
							hx-swap="innerHTML"
						>
							<p class="text-muted">Loading...</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<h2 class="section-title">Fuel</h2>
		<div
			id="fuel-table"
			hx-get={ fmt.Sprintf("/dispatch/trips/%d/fuel", trip.ID) }
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<p class="text-muted">Loading...</p>
		</div>
		<h2 class="section-title">Expenses</h2>
		<div
			id="expense-table"
			hx-get={ fmt.Sprintf("/dispatch/trips/%d/expenses", trip.ID) }
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<p class="text-muted">Loading...</p>
		</div>
		<h2 class="section-title">Routes</h2>
		<div
			id="route-table"
			hx-get={ fmt.Sprintf("/dispatch/trips/%d/routes", trip.ID) }
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<p class="text-muted">Loading...</p>
		</div>
		<h2 class="section-title">Damage &amp; Inspection Photos</h2>
		<div
			id="damage-section"
			hx-get={ fmt.Sprintf("/dispatch/trips/%d/damage", trip.ID) }
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<p class="text-muted">Loading...</p>
		</div>
		<h2 class="section-title">Attachments</h2>
		<div class="card" id="attachments-section">
			<div class="card-body">
				<div id="trip-attachments">
					@attachments.AttachmentList(atts, "trips", trip.ID)
				</div>
				<form
					hx-post={ fmt.Sprintf("/dispatch/trips/%d/attachments", trip.ID) }
					hx-target="#trip-attachments"
					hx-swap="innerHTML"
					hx-encoding="multipart/form-data"
					hx-on::after-request="if(event.detail.successful) this.reset()"
				>
					<div style="display: flex; align-items: center; gap: 12px; margin-top: 1rem;">
						<input type="file" name="file" accept="image/*"/>
						<button type="submit" class="btn btn-sm btn-primary">Upload</button>
					</div>
				</form>
			</div>
		</div>
	}
}

// Alpine.js attribute helpers for templ compatibility.

func escapeKeyAttr() templ.Attributes {
	return templ.Attributes{"@keydown.escape.window": "showModal = false"}
}

func showModalAttr() templ.Attributes {
	return templ.Attributes{"@click": "showModal = true"}
}

func modalBackdropAttrs() templ.Attributes {
	return templ.Attributes{"@click.self": "showModal = false"}
}

func stopClickAttr() templ.Attributes {
	return templ.Attributes{"@click.stop": ""}
}

func closeModalAttr() templ.Attributes {
	return templ.Attributes{"@click": "showModal = false"}
}
