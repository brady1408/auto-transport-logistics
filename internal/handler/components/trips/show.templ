package trips

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/handler/components/attachments"
	"github.com/brady1408/auto-transport-logistics/internal/models"
	"github.com/brady1408/auto-transport-logistics/internal/store"
)

templ ShowPage(pg components.PageContext, trip *models.Trip, loads []store.LoadDetailWithOrder, vehicleCount int, atts []models.Attachment) {
	@components.Layout(pg, "Trip " + trip.LoadNumber) {
		<div class="max-w-[1400px] mx-auto space-y-6">
			<!-- Header -->
			<header class="flex justify-between items-center">
				<div class="flex items-center gap-4">
					<a href="/dispatch/trips" class="p-2 hover:bg-surface-container rounded-full no-underline text-on-surface-variant">
						<span class="material-symbols-outlined">arrow_back</span>
					</a>
					<div class="flex items-center gap-3">
						<h1 class="text-3xl font-extrabold tracking-tight text-on-surface" style="font-family: 'Manrope', sans-serif;">Trip { trip.LoadNumber }</h1>
						if trip.Active {
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-secondary-container text-on-secondary-container">ACTIVE</span>
						} else {
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-surface-container-highest text-on-surface-variant">INACTIVE</span>
						}
					</div>
				</div>
				<div class="flex items-center gap-3">
					<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d/edit", trip.ID)) } class="px-4 py-2 bg-primary-container text-white rounded-xl text-sm font-bold flex items-center gap-2 shadow-md hover:opacity-90 transition-all no-underline">
						<span class="material-symbols-outlined text-[18px]">edit</span>
						Edit Trip
					</a>
				</div>
			</header>
			<!-- Info Cards -->
			<section class="grid grid-cols-1 md:grid-cols-4 gap-4">
				<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm">
					<span class="text-[10px] font-bold text-outline uppercase tracking-widest block mb-2">Trip Date</span>
					<p class="font-bold text-on-surface" style="font-family: 'Manrope', sans-serif;">
						if trip.TripDate != nil {
							{ trip.TripDate.Format("Jan 2, 2006") }
						} else {
							<span class="text-outline">—</span>
						}
					</p>
					if trip.EstDeliverDate != nil {
						<p class="text-xs text-on-surface-variant mt-1">Est. delivery: { trip.EstDeliverDate.Format("Jan 2, 2006") }</p>
					}
				</div>
				<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm">
					<span class="text-[10px] font-bold text-outline uppercase tracking-widest block mb-2">Truck & Driver</span>
					<p class="font-bold text-on-surface truncate" style="font-family: 'Manrope', sans-serif;">{ components.Deref(trip.TruckNumber) }</p>
					<p class="text-xs text-on-surface-variant mt-1 flex items-center gap-1">
						<span class="material-symbols-outlined text-sm">person</span>
						{ components.Deref(trip.Driver) }
						if components.Deref(trip.Driver2) != "" {
							 / { components.Deref(trip.Driver2) }
						}
					</p>
				</div>
				<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm">
					<span class="text-[10px] font-bold text-outline uppercase tracking-widest block mb-2">Zone & Equipment</span>
					if components.Deref(trip.Zone) != "" {
						<span class="px-2 py-0.5 rounded bg-surface-container-high text-[11px] font-bold">{ components.Deref(trip.Zone) }</span>
					}
					if components.Deref(trip.EquipmentType) != "" {
						<p class="text-xs text-on-surface-variant mt-2">{ components.Deref(trip.EquipmentType) }</p>
					}
				</div>
				<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm">
					<span class="text-[10px] font-bold text-outline uppercase tracking-widest block mb-2">Summary</span>
					<p class="text-2xl font-extrabold text-on-surface" style="font-family: 'Manrope', sans-serif;">{ fmt.Sprintf("%d", vehicleCount) } <span class="text-sm font-normal text-outline">vehicles</span></p>
					if trip.TotalMileage != nil {
						<p class="text-xs text-on-surface-variant mt-1">{ fmt.Sprintf("%d", components.DerefInt(trip.TotalMileage)) } miles</p>
					}
				</div>
			</section>
			<!-- Notes -->
			if components.Deref(trip.Comments) != "" {
				<div class="bg-primary-container text-white p-4 rounded-xl flex items-center gap-3">
					<span class="material-symbols-outlined text-on-primary-container">info</span>
					<p class="text-sm font-medium">Notes: <span class="opacity-80 font-normal">{ components.Deref(trip.Comments) }</span></p>
				</div>
			}
			<!-- Load Manifest -->
			<div x-data="{ showModal: false }" { escapeKeyAttr()... }>
				<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/[0.15] overflow-hidden shadow-sm">
					<div class="px-6 py-4 flex justify-between items-center bg-surface-container-low/50">
						<div class="flex items-center gap-3">
							<span class="material-symbols-outlined text-on-surface-variant">inventory_2</span>
							<h2 class="font-bold text-lg text-on-surface" style="font-family: 'Manrope', sans-serif;">Load Manifest</h2>
							<span class="bg-surface-container px-2 py-0.5 rounded text-xs font-bold text-on-surface-variant">{ fmt.Sprintf("%d VEHICLES", vehicleCount) }</span>
						</div>
						<button class="text-sm font-bold text-on-primary-container flex items-center gap-1 hover:underline" { showModalAttr()... }>
							<span class="material-symbols-outlined text-lg">add</span> Assign Vehicles
						</button>
					</div>
					<div
						id="load-manifest"
						hx-get={ fmt.Sprintf("/dispatch/trips/%d/loads", trip.ID) }
						hx-trigger="vehicle-assigned from:body, every 10s [document.visibilityState==='visible']"
						hx-swap="innerHTML"
					>
						@LoadTable(loads, trip.ID)
					</div>
				</section>
				<!-- Available Vehicles Modal -->
				<div
					x-show="showModal" x-cloak class="modal-backdrop"
					{ modalBackdropAttrs()... }
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
				>
					<div class="modal-dialog" { stopClickAttr()... }>
						<div class="modal-header">
							<h3>Add Vehicles to Trip { trip.LoadNumber }</h3>
							<button class="modal-close" { closeModalAttr()... }>&times;</button>
						</div>
						<div class="modal-body">
							<div
								id="modal-vehicle-list"
								hx-get={ fmt.Sprintf("/dispatch/trips/%d/available-vehicles", trip.ID) }
								hx-trigger="intersect once, vehicle-assigned from:body"
								hx-swap="innerHTML"
							>
								<p class="text-outline p-4 text-center">Loading...</p>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Fuel & Expenses side by side -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Fuel -->
				<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/[0.15] overflow-hidden shadow-sm">
					<div class="px-6 py-4 flex items-center gap-3">
						<span class="material-symbols-outlined text-on-surface-variant">local_gas_station</span>
						<h2 class="font-bold text-on-surface" style="font-family: 'Manrope', sans-serif;">Fuel Stops</h2>
					</div>
					<div
						id="fuel-table"
						hx-get={ fmt.Sprintf("/dispatch/trips/%d/fuel", trip.ID) }
						hx-trigger="load, every 10s [document.visibilityState==='visible']"
						hx-swap="innerHTML"
					>
						<p class="p-6 text-outline text-sm text-center">Loading...</p>
					</div>
				</section>
				<!-- Expenses -->
				<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/[0.15] overflow-hidden shadow-sm">
					<div class="px-6 py-4 flex items-center gap-3">
						<span class="material-symbols-outlined text-on-surface-variant">payments</span>
						<h2 class="font-bold text-on-surface" style="font-family: 'Manrope', sans-serif;">Expenses</h2>
					</div>
					<div
						id="expense-table"
						hx-get={ fmt.Sprintf("/dispatch/trips/%d/expenses", trip.ID) }
						hx-trigger="load, every 10s [document.visibilityState==='visible']"
						hx-swap="innerHTML"
					>
						<p class="p-6 text-outline text-sm text-center">Loading...</p>
					</div>
				</section>
			</div>
			<!-- Routes & Damages side by side -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Routes -->
				<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/[0.15] overflow-hidden shadow-sm">
					<div class="px-6 py-4 flex items-center gap-3">
						<span class="material-symbols-outlined text-on-surface-variant">route</span>
						<h2 class="font-bold text-on-surface" style="font-family: 'Manrope', sans-serif;">Route Plan</h2>
					</div>
					<div
						id="route-table"
						hx-get={ fmt.Sprintf("/dispatch/trips/%d/routes", trip.ID) }
						hx-trigger="load, every 10s [document.visibilityState==='visible']"
						hx-swap="innerHTML"
					>
						<p class="p-6 text-outline text-sm text-center">Loading...</p>
					</div>
				</section>
				<!-- Damages -->
				<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/[0.15] overflow-hidden shadow-sm">
					<div class="px-6 py-4 flex items-center gap-3">
						<span class="material-symbols-outlined text-error">report_problem</span>
						<h2 class="font-bold text-on-surface" style="font-family: 'Manrope', sans-serif;">Damage & Inspection</h2>
					</div>
					<div
						id="damage-section"
						hx-get={ fmt.Sprintf("/dispatch/trips/%d/damage", trip.ID) }
						hx-trigger="load, every 10s [document.visibilityState==='visible']"
						hx-swap="innerHTML"
					>
						<p class="p-6 text-outline text-sm text-center">Loading...</p>
					</div>
				</section>
			</div>
			<!-- Attachments -->
			<section class="bg-surface-container-lowest rounded-xl border border-outline-variant/[0.15] overflow-hidden shadow-sm">
				<div class="px-6 py-4 flex justify-between items-center">
					<div class="flex items-center gap-3">
						<span class="material-symbols-outlined text-on-surface-variant">attach_file</span>
						<h2 class="font-bold text-on-surface" style="font-family: 'Manrope', sans-serif;">Attachments</h2>
					</div>
				</div>
				<div class="px-6 pb-6">
					<div id="trip-attachments">
						@attachments.AttachmentList(atts, "trips", trip.ID)
					</div>
					<form
						hx-post={ fmt.Sprintf("/dispatch/trips/%d/attachments", trip.ID) }
						hx-target="#trip-attachments"
						hx-swap="innerHTML"
						hx-encoding="multipart/form-data"
						hx-on::after-request="if(event.detail.successful) this.reset()"
						class="mt-4"
					>
						<div class="flex items-center gap-3">
							<input type="file" name="file" accept="image/*" class="text-xs"/>
							<button type="submit" class="px-3 py-1.5 bg-primary-container text-white rounded-lg text-xs font-bold hover:opacity-90 transition-all">Upload</button>
						</div>
					</form>
				</div>
			</section>
		</div>
	}
}

// Alpine.js attribute helpers for templ compatibility.

func escapeKeyAttr() templ.Attributes {
	return templ.Attributes{"@keydown.escape.window": "showModal = false"}
}

func showModalAttr() templ.Attributes {
	return templ.Attributes{"@click": "showModal = true"}
}

func modalBackdropAttrs() templ.Attributes {
	return templ.Attributes{"@click.self": "showModal = false"}
}

func stopClickAttr() templ.Attributes {
	return templ.Attributes{"@click.stop": ""}
}

func closeModalAttr() templ.Attributes {
	return templ.Attributes{"@click": "showModal = false"}
}
