package settings

import (
	"fmt"
	"strings"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

// SubscriptionPageData carries all data the subscription page needs.
type SubscriptionPageData struct {
	Sub        *models.Subscription
	UserCount  int
	UserLimit  int
	OrderCount int
}

// TierUserLimitValue returns the user-seat cap for a given tier (base band).
func TierUserLimitValue(tier models.Tier) int {
	switch tier {
	case models.TierEnterprise:
		return 0 // custom / unlimited
	default:
		return 3 // Basic and Pro both start at 3 users
	}
}

func tierLabel(tier models.Tier) string {
	switch tier {
	case models.TierPro:
		return "Pro"
	case models.TierEnterprise:
		return "Enterprise"
	default:
		return "Basic"
	}
}

// bandLabel returns the pricing band label based on active user count.
func bandLabel(users int) string {
	if users <= 3 {
		return "1–3 users"
	}
	if users <= 10 {
		return "4–10 users"
	}
	return "11+ users"
}

// bandPrice returns the effective price string for a tier at the given user count.
func bandPrice(tier models.Tier, users int) string {
	if tier == models.TierEnterprise {
		return "Custom"
	}
	if users <= 3 {
		if tier == models.TierPro {
			return "$79"
		}
		return "$49"
	}
	if users <= 10 {
		if tier == models.TierPro {
			return "$109"
		}
		return "$69"
	}
	// 11+ users: base (4-10 band) + per-user for extras
	extra := users - 10
	if tier == models.TierPro {
		return fmt.Sprintf("$%d", 109+extra*14)
	}
	return fmt.Sprintf("$%d", 69+extra*9)
}

// bandNote returns a short explanation of the per-user pricing for 11+ bands.
func bandNote(tier models.Tier, users int) string {
	if tier == models.TierEnterprise || users <= 10 {
		return ""
	}
	extra := users - 10
	if tier == models.TierPro {
		return fmt.Sprintf("$109 base + %d extra × $14/user", extra)
	}
	return fmt.Sprintf("$69 base + %d extra × $9/user", extra)
}

templ SubscriptionPage(pg components.PageContext, data SubscriptionPageData) {
	@components.Layout(pg, "Subscription - Settings") {
		<div class="sub-page">
			<div class="page-header">
				<h2>Subscription</h2>
			</div>

			@currentPlanCard(data)
			@usageMetrics(data)
			@planComparison(data)
			@billingHistory()
			@dangerZone(pg)
		</div>
	}
}

templ currentPlanCard(data SubscriptionPageData) {
	<div class="sub-plan-card">
		<div class="sub-plan-info">
			<div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
				<span class="sub-badge sub-badge-tier">{ tierLabel(data.Sub.Tier) }</span>
				if data.Sub.Status == models.StatusActive {
					<span class="sub-badge sub-badge-active">Active</span>
				} else {
					<span class="sub-badge sub-badge-suspended">Suspended</span>
				}
				<span class="sub-badge sub-badge-beta">Beta</span>
			</div>
			<div class="sub-plan-price">
				{ bandPrice(data.Sub.Tier, data.UserCount) }
				if data.Sub.Tier != models.TierEnterprise {
					<span>/ mo</span>
				}
			</div>
			if bandNote(data.Sub.Tier, data.UserCount) != "" {
				<p style="font-size:0.75rem; color:var(--gray-400); margin-top:2px;">
					{ bandNote(data.Sub.Tier, data.UserCount) }
				</p>
			}
			<dl class="sub-plan-meta">
				<div>
					<dt>Active Users</dt>
					<dd>{ fmt.Sprintf("%d", data.UserCount) }</dd>
				</div>
				<div>
					<dt>Pricing Band</dt>
					<dd>{ bandLabel(data.UserCount) }</dd>
				</div>
				<div>
					<dt>Since</dt>
					<dd>{ data.Sub.CreatedAt.Format("Jan 2006") }</dd>
				</div>
			</dl>
		</div>
	</div>
}

templ usageMetrics(data SubscriptionPageData) {
	<div class="sub-metrics">
		<div class="sub-metric-card">
			<div class="sub-metric-label">Active Users</div>
			<div class="sub-metric-value">{ fmt.Sprintf("%d", data.UserCount) }</div>
			<p style="font-size:0.75rem; color:var(--gray-400); margin-top:4px;">{ bandLabel(data.UserCount) } band</p>
		</div>
		<div class="sub-metric-card">
			<div class="sub-metric-label">Orders (30 days)</div>
			<div class="sub-metric-value">{ fmt.Sprintf("%d", data.OrderCount) }</div>
		</div>
		<div class="sub-metric-card">
			<div class="sub-metric-label">Effective Rate</div>
			<div class="sub-metric-value">
				{ bandPrice(data.Sub.Tier, data.UserCount) }
				if data.Sub.Tier != models.TierEnterprise {
					<span>/ mo</span>
				}
			</div>
		</div>
	</div>
}

type planCard struct {
	Tier     models.Tier
	Name     string
	Subtitle string
	Features []string
}

func planCards() []planCard {
	return []planCard{
		{
			Tier: models.TierBasic, Name: "Basic",
			Subtitle: "Everything you need to run your operation.",
			Features: []string{
				"Order Management",
				"VIN Tracking & NHTSA Decode",
				"Dispatch & Trip Management",
				"Invoicing & Payments",
				"Credit Memos & Damage Claims",
				"QuickBooks Integration",
				"10+ Reports & CSV Export",
				"Dashboard & Analytics",
			},
		},
		{
			Tier: models.TierPro, Name: "Pro",
			Subtitle: "For teams that need the full platform.",
			Features: []string{
				"Everything in Basic, plus:",
				"Loadboard Access",
				"Post & Browse Loads",
				"Claim Management",
				"Loadboard Messaging",
			},
		},
		{
			Tier: models.TierEnterprise, Name: "Enterprise",
			Subtitle: "Tailored for high-volume operations.",
			Features: []string{
				"Everything in Pro, plus:",
				"Custom Integrations",
				"Volume Pricing",
				"Priority Support",
				"Dedicated Onboarding",
			},
		},
	}
}

templ planComparison(data SubscriptionPageData) {
	<h3 style="margin-bottom:12px">Plans</h3>
	<div class="sub-tiers">
		for _, p := range planCards() {
			<div class={ "sub-tier-card", templ.KV("current", p.Tier == data.Sub.Tier) }>
				if p.Tier == data.Sub.Tier {
					<div style="margin-bottom:4px;">
						<span class="sub-badge sub-badge-tier">Current Plan</span>
					</div>
				}
				<div class="sub-tier-name">{ p.Name }</div>
				<div class="sub-tier-price">
					{ bandPrice(p.Tier, data.UserCount) }
					if p.Tier != models.TierEnterprise {
						<span>/ mo</span>
					}
				</div>
				<p style="font-size:0.75rem; color:var(--gray-400); margin-bottom:4px;">
					{ fmt.Sprintf("for %d active users", data.UserCount) }
				</p>
				<p style="font-size:0.8125rem; color:var(--gray-400); margin-bottom:12px;">{ p.Subtitle }</p>
				<ul class="sub-tier-features">
					for _, f := range p.Features {
						<li>
							<span class="check">&#10003;</span>
							{ f }
						</li>
					}
				</ul>
				if p.Tier == data.Sub.Tier {
					<button class="btn" disabled>Current Plan</button>
				} else if p.Tier == models.TierEnterprise {
					<button class="btn" disabled title="Coming soon">Contact Us</button>
				} else if strings.Compare(p.Tier, data.Sub.Tier) > 0 {
					<button class="btn btn-primary" disabled title="Coming soon">Upgrade</button>
				} else {
					<button class="btn" disabled title="Coming soon">Downgrade</button>
				}
			</div>
		}
	</div>
	<!-- Band pricing reference -->
	<div style="background:white; border-radius:var(--radius); padding:20px; box-shadow:var(--shadow); margin-bottom:24px;">
		<h4 style="font-size:0.8125rem; font-weight:700; text-align:center; margin-bottom:12px;">Growing team? We scale with you.</h4>
		<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; text-align:center; font-size:0.8125rem;">
			<div>
				<p style="color:var(--gray-400); font-weight:600; margin-bottom:4px;">1–3 users</p>
				<p style="font-weight:700;">Basic $49 · Pro $79</p>
			</div>
			<div>
				<p style="color:var(--gray-400); font-weight:600; margin-bottom:4px;">4–10 users</p>
				<p style="font-weight:700;">Basic $69 · Pro $109</p>
			</div>
			<div>
				<p style="color:var(--gray-400); font-weight:600; margin-bottom:4px;">11+ users</p>
				<p style="font-weight:700;">+$9/user · +$14/user</p>
			</div>
		</div>
	</div>
}

templ billingHistory() {
	<h3 style="margin-bottom:12px">Billing History</h3>
	<div class="sub-history">
		<div class="sub-history-empty">
			No billing history yet. ATLinks is currently in beta &mdash; all plans are free.
		</div>
	</div>
}

templ dangerZone(pg components.PageContext) {
	<h3 style="margin-bottom:12px">Danger Zone</h3>
	<div class="sub-danger" x-data="{ confirm: '' }">
		<h3>Cancel Subscription</h3>
		<p>
			Cancelling will immediately revoke access for all users in your company.
			This action cannot be undone. Type your company name to confirm.
		</p>
		<div class="sub-danger-confirm">
			<input type="text" placeholder={ pg.CompanyName } x-model="confirm"/>
			<button
				class="btn btn-danger"
				disabled
				x-bind:disabled={ fmt.Sprintf("confirm !== '%s'", pg.CompanyName) }
				title="Contact support to cancel"
			>
				Cancel Subscription
			</button>
		</div>
	</div>
}
