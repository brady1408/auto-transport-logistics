package orders

import (
	"fmt"
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
	"github.com/brady1408/auto-transport-logistics/internal/store"
)

templ WaitingGridPage(pg components.PageContext, rows []store.WaitingVehicleRow, stateFilter string) {
	@components.Layout(pg, "Waiting Grid") {
		<!-- Page Header -->
		<div class="flex items-end justify-between mb-6">
			<div>
				<nav class="flex items-center gap-2 text-xs text-outline mb-2 font-medium tracking-wide uppercase">
					<span>Dispatch</span>
					<span class="material-symbols-outlined text-[14px]">chevron_right</span>
					<span class="text-secondary">Waiting Grid</span>
				</nav>
				<div class="flex items-center gap-4">
					<h1 class="text-3xl font-extrabold tracking-tight text-on-surface" style="font-family: 'Manrope', sans-serif;">Waiting Grid</h1>
					<div class="bg-surface-container-highest px-3 py-1 rounded-xl flex items-center gap-2">
						<span class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Pending</span>
						<span class="text-lg font-extrabold leading-none">{ fmt.Sprintf("%d", len(rows)) }</span>
					</div>
				</div>
				<p class="text-on-surface-variant text-sm mt-1">Vehicle transport backlog and assignment queue</p>
			</div>
		</div>
		<!-- Filter Bar -->
		<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm border border-outline-variant/10 mb-6">
			<div class="flex flex-wrap items-end gap-4">
				<div class="min-w-[120px]">
					<label for="state" class="text-[10px] font-bold text-outline uppercase tracking-widest block mb-1.5">Origin State</label>
					<input
						type="text" id="state" name="state"
						class="w-full bg-surface-container-low border-none rounded-lg text-sm font-medium py-2.5 px-3 focus:ring-2 focus:ring-primary-container/20 uppercase"
						maxlength="2"
						placeholder="e.g. MI"
						value={ stateFilter }
						hx-get="/dispatch/waiting"
						hx-trigger="keyup changed delay:400ms"
						hx-target="#waiting-table"
						hx-include="[name=state]"
						style="font-family: 'Inter', sans-serif;"
					/>
				</div>
			</div>
		</div>
		<!-- Flash slot (out-of-band swap target for assign success) -->
		<div id="waiting-flash"></div>
		<!-- Waiting Table -->
		<div id="waiting-table">
			@WaitingGridTable(rows, stateFilter)
		</div>
	}
}

// WaitingFlashOOB is an out-of-band swap that drops a transient success banner into
// the #waiting-flash slot after an HTMX assign, mirroring the app's flash pattern.
templ WaitingFlashOOB(msg string) {
	<div id="waiting-flash" hx-swap-oob="innerHTML">
		<div class="alert alert-success" id="waiting-flash-msg" style="margin-bottom:1rem;">{ msg }</div>
		<script>setTimeout(function(){ var el = document.getElementById('waiting-flash-msg'); if (el) el.remove(); }, 4000);</script>
	</div>
}

templ WaitingGridTable(rows []store.WaitingVehicleRow, stateFilter string) {
	<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-outline-variant/10">
		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="bg-surface-container-low/50">
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">VIN</th>
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Make / Model</th>
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Order</th>
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Pickup</th>
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Dropoff</th>
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest text-right">Amount</th>
						<th class="px-6 py-4 text-[10px] font-bold text-on-surface-variant uppercase tracking-widest text-right">Action</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-outline-variant/10">
					if len(rows) > 0 {
						for _, r := range rows {
							<tr class="hover:bg-surface-container-low/50 transition-colors">
								<td class="px-6 py-3">
									<span class="text-sm font-mono font-semibold tracking-tighter text-on-surface">{ r.VIN }</span>
								</td>
								<td class="px-6 py-3">
									<p class="text-sm font-bold text-slate-900 leading-tight">{ components.Deref(r.Year) } { components.Deref(r.Make) } { components.Deref(r.Model) }</p>
								</td>
								<td class="px-6 py-3">
									<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/orders/%d", r.OrderID)) } class="bg-surface-container-high px-2 py-0.5 rounded-md text-[11px] font-bold font-mono no-underline hover:underline text-on-primary-container">{ r.OrderNumber }</a>
								</td>
								<td class="px-6 py-3">
									<p class="text-sm font-semibold">{ r.PickupName }</p>
									<p class="text-[10px] text-slate-500">{ components.Deref(r.PickupCity) }, { components.Deref(r.PickupState) }</p>
								</td>
								<td class="px-6 py-3">
									<p class="text-sm font-semibold">{ r.DropName }</p>
									<p class="text-[10px] text-slate-500">{ components.Deref(r.DropCity) }</p>
								</td>
								<td class="px-6 py-3 text-right">
									if components.Deref(r.Amount) != "" {
										<span class="text-sm font-bold">${ components.Deref(r.Amount) }</span>
									}
								</td>
								<td class="px-6 py-3 text-right">
									<div class="inline-flex items-center gap-2 justify-end" x-data="{ open: false }" @keydown.escape.window="open = false">
										<div class="relative">
											<button
												type="button"
												class="bg-primary-container text-white px-3 py-1.5 rounded-lg text-xs font-bold hover:opacity-90 transition-all inline-flex items-center gap-1"
												@click="open = !open"
											>
												<span class="material-symbols-outlined text-[16px] leading-none">local_shipping</span> Assign to Trip
											</button>
											<div
												x-show="open"
												x-cloak
												@click.outside="open = false"
												x-transition.opacity
												class="absolute right-0 mt-2 w-80 z-20 bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant/20 text-left"
											>
												<div
													hx-get={ fmt.Sprintf("/dispatch/waiting/trip-picker?vehicle_id=%d&state=%s", r.VehicleID, stateFilter) }
													hx-trigger="intersect once"
													hx-swap="innerHTML"
												>
													<p class="text-outline p-4 text-center text-sm">Loading trips...</p>
												</div>
											</div>
										</div>
										<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/orders/%d", r.OrderID)) } class="bg-surface-container-high text-on-surface px-3 py-1.5 rounded-lg text-xs font-bold no-underline hover:opacity-90 transition-all">View Order</a>
									</div>
								</td>
							</tr>
						}
					} else {
						<tr><td colspan="7" class="text-center text-outline py-12">No vehicles waiting</td></tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// WaitingTripPicker renders the active-trip chooser inside a waiting-grid row popover.
// Selecting a trip posts to /dispatch/waiting/assign, which swaps the whole grid.
templ WaitingTripPicker(vehicleID int, trips []models.Trip, stateFilter string) {
	<div class="max-h-80 overflow-y-auto">
		<div class="px-4 py-3 border-b border-outline-variant/20">
			<p class="text-[10px] font-bold text-outline uppercase tracking-widest">Assign to active trip</p>
		</div>
		if len(trips) > 0 {
			<ul class="divide-y divide-outline-variant/10">
				for _, t := range trips {
					<li class="px-4 py-2.5 hover:bg-surface-container-low/60 transition-colors flex items-center justify-between gap-3">
						<div class="min-w-0">
							<p class="text-sm font-bold text-on-surface truncate">Trip { t.LoadNumber }</p>
							<p class="text-[11px] text-on-surface-variant truncate">
								{ tripPickerMeta(t) }
							</p>
						</div>
						<button
							type="button"
							class="shrink-0 bg-primary-container text-white px-2.5 py-1 rounded-md text-[11px] font-bold hover:opacity-90 transition-all"
							hx-post="/dispatch/waiting/assign"
							hx-vals={ fmt.Sprintf(`{"vehicle_id": "%d", "trip_id": "%d", "state": "%s"}`, vehicleID, t.ID, stateFilter) }
							hx-target="#waiting-table"
							hx-swap="innerHTML"
							hx-confirm={ fmt.Sprintf("Assign this vehicle to trip %s?", t.LoadNumber) }
						>Assign</button>
					</li>
				}
			</ul>
		} else {
			<p class="text-outline p-4 text-center text-sm">No active trips available</p>
		}
	</div>
}

// tripPickerMeta builds a compact "driver · truck # · date" line for the picker,
// omitting any pieces the trip doesn't have.
func tripPickerMeta(t models.Trip) string {
	parts := make([]string, 0, 3)
	if d := components.Deref(t.Driver); d != "" {
		parts = append(parts, d)
	}
	if tn := components.Deref(t.TruckNumber); tn != "" {
		parts = append(parts, "Truck "+tn)
	}
	if t.TripDate != nil {
		parts = append(parts, t.TripDate.Format("Jan 2, 2006"))
	}
	if len(parts) == 0 {
		return "—"
	}
	out := parts[0]
	for _, p := range parts[1:] {
		out += " · " + p
	}
	return out
}
