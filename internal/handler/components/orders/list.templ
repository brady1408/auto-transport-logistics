package orders

import (
	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ ListPage(pg components.PageContext, result models.OrderListResult, filter models.OrderFilter) {
	@components.Layout(pg, "Orders - ATLinks") {
		<div class="page-header">
			<h1>Orders</h1>
			<a href="/dispatch/orders/new" class="btn btn-primary">New Order</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Order #, customer name..."
					value={ filter.Search }
					hx-get="/dispatch/orders"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#order-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="active">Status</label>
				<select
					id="active" name="active" class="form-control"
					hx-get="/dispatch/orders"
					hx-trigger="change"
					hx-target="#order-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="" selected?={ filter.Active == "" }>All</option>
					<option value="active" selected?={ filter.Active == "active" }>Active</option>
					<option value="inactive" selected?={ filter.Active == "inactive" }>Inactive</option>
				</select>
			</div>
			<div class="form-group">
				<label for="date_from">From</label>
				<input
					type="date" id="date_from" name="date_from" class="form-control"
					value={ filter.DateFrom }
					hx-get="/dispatch/orders"
					hx-trigger="change"
					hx-target="#order-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="date_to">To</label>
				<input
					type="date" id="date_to" name="date_to" class="form-control"
					value={ filter.DateTo }
					hx-get="/dispatch/orders"
					hx-trigger="change"
					hx-target="#order-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<input type="hidden" name="sort_by" value={ filter.SortBy }/>
			<input type="hidden" name="sort_dir" value={ filter.SortDir }/>
		</div>
		<div id="order-table">
			@Table(result, filter)
		</div>
	}
}
