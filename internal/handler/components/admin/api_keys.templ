package admin

import (
	"fmt"
	"time"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ApiKeysPage(pg components.PageContext, keys []models.ApiKey, newRawKey string) {
	@components.Layout(pg, "API Keys - Admin") {
		<div class="page-header">
			<h2>API Keys</h2>
		</div>
		if newRawKey != "" {
			<div class="alert alert-warning" style="background:var(--yellow-50,#fffbeb);border:1px solid var(--yellow-300,#fcd34d);border-radius:6px;padding:1rem 1.25rem;margin-bottom:1.5rem;">
				<strong>New API Key Created — Save It Now!</strong>
				<p style="margin:.5rem 0 .25rem;font-size:.875rem;color:var(--gray-600)">This key will not be shown again. Copy it before leaving this page.</p>
				<code style="display:block;background:var(--gray-100);padding:.5rem .75rem;border-radius:4px;word-break:break-all;font-size:.9rem;margin-top:.5rem">{ newRawKey }</code>
			</div>
		}
		<div class="table-container">
			<table class="data-table">
				<thead>
					<tr>
						<th>ID</th>
						<th>Label</th>
						<th>User</th>
						<th>Status</th>
						<th>Created</th>
						<th>Last Used</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					if len(keys) == 0 {
						<tr><td colspan="7" style="text-align:center;color:var(--gray-400)">No API keys found</td></tr>
					}
					for _, k := range keys {
						<tr>
							<td>{ fmt.Sprintf("%d", k.ID) }</td>
							<td>{ k.Label }</td>
							<td>{ k.Username }</td>
							<td>
								if k.Active {
									<span class="badge badge-active">Active</span>
								} else {
									<span class="badge badge-inactive">Revoked</span>
								}
							</td>
							<td>{ k.CreatedAt.Format(time.RFC3339)[:10] }</td>
							<td>
								if k.LastUsedAt != nil {
									{ k.LastUsedAt.Format(time.RFC3339)[:10] }
								} else {
									<span style="color:var(--gray-400)">never</span>
								}
							</td>
							<td>
								if k.Active {
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/api-keys/%d/revoke", k.ID)) } style="display:inline" onsubmit="return confirm('Revoke this API key? It will stop working immediately.')">
										<button type="submit" class="btn btn-sm btn-danger">Revoke</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h3 style="margin:2rem 0 .75rem">Create New API Key</h3>
		<div class="card" style="max-width:480px">
			<div class="card-body">
				<form method="POST" action="/admin/api-keys">
					<input type="hidden" name="csrf_token" value={ pg.CSRFToken }/>
					<div class="form-group">
						<label for="label">Label</label>
						<input type="text" id="label" name="label" class="form-control" placeholder="e.g. MCP Server, CI Bot" required maxlength="100"/>
					</div>
					<button type="submit" class="btn btn-primary">Generate Key</button>
				</form>
			</div>
		</div>
	}
}
