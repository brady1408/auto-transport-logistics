package components

templ FeedbackButton() {
	<div x-data="{ open: false, submitted: false }" @feedback-submitted.window="submitted = true; setTimeout(() => { open = false; submitted = false; }, 2000)">
		<!-- Floating button -->
		<button @click="open = !open" class="feedback-fab" title="Send Feedback">
			?
		</button>
		<!-- Modal backdrop + dialog -->
		<div x-show="open" x-cloak class="feedback-overlay" @click.self="open = false">
			<div class="feedback-modal">
				<div class="feedback-modal-header">
					<h3>Send Feedback</h3>
					<button @click="open = false" class="feedback-close">&times;</button>
				</div>
				<div id="feedback-form-area">
					<div x-show="submitted" class="alert alert-success" style="margin:0;">Feedback submitted — thank you!</div>
					<form x-show="!submitted" hx-post="/feedback/submit" hx-swap="none"
						  @htmx:after-request="if(event.detail.successful) { $dispatch('feedback-submitted'); $el.reset(); }">
						<input type="hidden" name="page_url" :value="window.location.pathname"/>
						<div class="form-group">
							<label for="fb-category">Type</label>
							<select id="fb-category" name="category" class="form-control">
								<option value="bug">Bug Report</option>
								<option value="feature">Feature Request</option>
								<option value="question">Question</option>
							</select>
						</div>
						<div class="form-group">
							<label for="fb-message">Message</label>
							<textarea id="fb-message" name="message" class="form-control" rows="4"
									  placeholder="Describe the issue or suggestion..." required></textarea>
						</div>
						<button type="submit" class="btn btn-primary" style="width:100%;">Submit Feedback</button>
					</form>
				</div>
			</div>
		</div>
	</div>
}
