package employees

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ Table(result models.EmployeeListResult, filter models.EmployeeFilter) {
	<div class="table-container">
		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Phone</th>
					<th>City</th>
					<th>State</th>
					<th>Driver</th>
					<th>Status</th>
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				if len(result.Items) > 0 {
					for _, e := range result.Items {
						<tr>
							<td><a href={ templ.SafeURL(fmt.Sprintf("/global/employees/%d/edit", e.ID)) }>{ e.Name }</a></td>
							<td>{ components.Deref(e.Phone) }</td>
							<td>{ components.Deref(e.City) }</td>
							<td>{ components.Deref(e.State) }</td>
							<td>
								if e.IsDriver {
									<span class="badge badge-active">Yes</span>
								} else {
									No
								}
							</td>
							<td>
								if e.Active {
									<span class="badge badge-active">Active</span>
								} else {
									<span class="badge badge-inactive">Inactive</span>
								}
							</td>
							<td class="text-right">
								<div class="btn-group">
									<a href={ templ.SafeURL(fmt.Sprintf("/global/employees/%d/edit", e.ID)) } class="btn btn-sm">Edit</a>
									<button
										class="btn btn-sm btn-danger"
										hx-delete={ fmt.Sprintf("/global/employees/%d", e.ID) }
										hx-confirm={ fmt.Sprintf("Delete employee %s?", e.Name) }
									>Delete</button>
								</div>
							</td>
						</tr>
					}
				} else {
					<tr><td colspan="7" class="text-center text-muted">No employees found</td></tr>
				}
			</tbody>
		</table>
	</div>
	if len(result.Items) > 0 {
		@components.Pagination(components.NewPaginationData(
			result.Page, result.PageSize, result.TotalCount,
			"/global/employees", "#employee-table",
		))
	}
}
