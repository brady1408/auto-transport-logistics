package earnings

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ DriverListPage(pg components.PageContext, result models.DriverEarningsAdjResult, filter models.EarningsAdjFilter) {
	@components.Layout(pg, "Driver Adjustments - ATLinks") {
		<div class="page-header">
			<h1>Driver Pay Adjustments</h1>
			<a href="/accounting/driver-adjustments/new" class="btn btn-primary">New Adjustment</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="date_from">From</label>
				<input
					type="date" id="date_from" name="date_from" class="form-control"
					value={ filter.DateFrom }
					hx-get="/accounting/driver-adjustments"
					hx-trigger="change"
					hx-target="#adj-table"
					hx-include=".filter-bar [name]"
				/>
			</div>
			<div class="form-group">
				<label for="date_to">To</label>
				<input
					type="date" id="date_to" name="date_to" class="form-control"
					value={ filter.DateTo }
					hx-get="/accounting/driver-adjustments"
					hx-trigger="change"
					hx-target="#adj-table"
					hx-include=".filter-bar [name]"
				/>
			</div>
		</div>
		<div id="adj-table">
			@DriverTable(result, filter)
		</div>
	}
}

templ TruckListPage(pg components.PageContext, result models.TruckEarningsAdjResult, filter models.EarningsAdjFilter) {
	@components.Layout(pg, "Truck Adjustments - ATLinks") {
		<div class="page-header">
			<h1>Truck Pay Adjustments</h1>
			<a href="/accounting/truck-adjustments/new" class="btn btn-primary">New Adjustment</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="date_from">From</label>
				<input
					type="date" id="date_from" name="date_from" class="form-control"
					value={ filter.DateFrom }
					hx-get="/accounting/truck-adjustments"
					hx-trigger="change"
					hx-target="#adj-table"
					hx-include=".filter-bar [name]"
				/>
			</div>
			<div class="form-group">
				<label for="date_to">To</label>
				<input
					type="date" id="date_to" name="date_to" class="form-control"
					value={ filter.DateTo }
					hx-get="/accounting/truck-adjustments"
					hx-trigger="change"
					hx-target="#adj-table"
					hx-include=".filter-bar [name]"
				/>
			</div>
		</div>
		<div id="adj-table">
			@TruckTable(result, filter)
		</div>
	}
}
