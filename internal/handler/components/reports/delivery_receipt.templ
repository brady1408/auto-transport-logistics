package reports

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ DeliveryReceipt(order *models.Order, vehicles []models.OrderVehicle) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>Delivery Receipt - Order { order.OrderNumber }</title>
			<style>
				body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 12px; color: #333; margin: 40px; }
				.header { display: flex; justify-content: space-between; margin-bottom: 30px; }
				.company-name { font-size: 24px; font-weight: 700; color: #2563eb; }
				.doc-title { font-size: 28px; font-weight: 700; color: #333; text-align: right; }
				.meta { text-align: right; margin-top: 8px; }
				.meta div { margin-bottom: 4px; }
				.meta .label { color: #666; }
				.addresses { display: flex; gap: 40px; margin-bottom: 30px; }
				.address-block { flex: 1; }
				.address-title { font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; margin-bottom: 4px; }
				table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
				th { background: #f3f4f6; padding: 8px 12px; text-align: left; font-size: 11px; font-weight: 600; border-bottom: 2px solid #e5e7eb; }
				td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; }
				.text-right { text-align: right; }
				.sig-line { margin-top: 60px; display: flex; gap: 40px; }
				.sig-block { flex: 1; }
				.sig-block .line { border-top: 1px solid #333; padding-top: 4px; margin-top: 30px; font-size: 11px; color: #666; }
				@media print {
					body { margin: 20px; }
					@page { margin: 1cm; }
				}
			</style>
		</head>
		<body>
			<div class="header">
				<div>
					<div class="company-name">ATLinks</div>
					<div>Vehicle Transport Services</div>
				</div>
				<div>
					<div class="doc-title">DELIVERY RECEIPT</div>
					<div class="meta">
						<div><span class="label">Order #:</span> <strong>{ order.OrderNumber }</strong></div>
						if order.BOLNumber != nil {
							<div><span class="label">BOL #:</span> { components.Deref(order.BOLNumber) }</div>
						}
						if order.CreateDate != nil {
							<div><span class="label">Date:</span> { order.CreateDate.Format("01/02/2006") }</div>
						}
						if order.OriginZone != nil {
							<div><span class="label">Zone:</span> { components.Deref(order.OriginZone) }</div>
						}
					</div>
				</div>
			</div>
			<div class="addresses">
				<div class="address-block">
					<div class="address-title">Load/Pickup</div>
					<strong>{ components.Deref(order.LoadCustomerName) }</strong>
					if order.LoadAddress != nil {
						<br/>
						{ components.Deref(order.LoadAddress) }
					}
					if order.LoadCity != nil {
						<br/>
						{ components.Deref(order.LoadCity) }, { components.Deref(order.LoadState) } { components.Deref(order.LoadZip) }
					}
					if order.LoadContact != nil {
						<br/>
						Contact: { components.Deref(order.LoadContact) }
					}
					if order.LoadPhone != nil {
						<br/>
						Phone: { components.Deref(order.LoadPhone) }
					}
				</div>
				<div class="address-block">
					<div class="address-title">Drop/Delivery</div>
					<strong>{ components.Deref(order.DropCustomerName) }</strong>
					if order.DropAddress != nil {
						<br/>
						{ components.Deref(order.DropAddress) }
					}
					if order.DropCity != nil {
						<br/>
						{ components.Deref(order.DropCity) }, { components.Deref(order.DropState) } { components.Deref(order.DropZip) }
					}
					if order.DropContact != nil {
						<br/>
						Contact: { components.Deref(order.DropContact) }
					}
					if order.DropPhone != nil {
						<br/>
						Phone: { components.Deref(order.DropPhone) }
					}
				</div>
				<div class="address-block">
					<div class="address-title">Bill To</div>
					<strong>{ components.Deref(order.BillCustomerName) }</strong>
					if order.BillToAddress != nil {
						<br/>
						{ components.Deref(order.BillToAddress) }
					}
					if order.BillToCity != nil {
						<br/>
						{ components.Deref(order.BillToCity) }, { components.Deref(order.BillToState) } { components.Deref(order.BillToZip) }
					}
				</div>
			</div>
			<table>
				<thead>
					<tr>
						<th>#</th>
						<th>VIN</th>
						<th>Year</th>
						<th>Make</th>
						<th>Model</th>
						<th>Color</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for i, v := range vehicles {
						<tr>
							<td>{ fmt.Sprintf("%d", i+1) }</td>
							<td>{ components.Deref(v.VIN) }</td>
							<td>{ components.Deref(v.Year) }</td>
							<td>{ components.Deref(v.Make) }</td>
							<td>{ components.Deref(v.Model) }</td>
							<td>{ components.Deref(v.Color) }</td>
							<td>{ v.Status }</td>
						</tr>
					}
				</tbody>
			</table>
			if order.PUInstructions != nil {
				<div style="margin-bottom: 12px;"><strong>Pickup Instructions:</strong> { components.Deref(order.PUInstructions) }</div>
			}
			if order.DOInstructions != nil {
				<div style="margin-bottom: 12px;"><strong>Delivery Instructions:</strong> { components.Deref(order.DOInstructions) }</div>
			}
			<div class="sig-line">
				<div class="sig-block">
					<div class="line">Driver Signature</div>
				</div>
				<div class="sig-block">
					<div class="line">Date</div>
				</div>
				<div class="sig-block">
					<div class="line">Received By</div>
				</div>
				<div class="sig-block">
					<div class="line">Date</div>
				</div>
			</div>
			<script>window.print();</script>
		</body>
	</html>
}
