package customers

import (
	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ ListPage(pg components.PageContext, result models.CustomerListResult, filter models.CustomerFilter) {
	@components.Layout(pg, "Customers - ATLinks") {
		<div class="page-header">
			<h1>Customers</h1>
			<a href="/global/customers/new" class="btn btn-primary">New Customer</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Name or number..."
					value={ filter.Search }
					hx-get="/global/customers"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#customer-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="type">Type</label>
				<select
					id="type" name="type" class="form-control"
					hx-get="/global/customers"
					hx-trigger="change"
					hx-target="#customer-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="">All Types</option>
					<option value="Bill" selected?={ filter.Type == "Bill" }>Bill</option>
					<option value="Load" selected?={ filter.Type == "Load" }>Load</option>
					<option value="Drop" selected?={ filter.Type == "Drop" }>Drop</option>
					<option value="Carrier" selected?={ filter.Type == "Carrier" }>Carrier</option>
				</select>
			</div>
			<div class="form-group">
				<label for="active">Status</label>
				<select
					id="active" name="active" class="form-control"
					hx-get="/global/customers"
					hx-trigger="change"
					hx-target="#customer-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="" selected?={ filter.Active == "" }>All</option>
					<option value="active" selected?={ filter.Active == "active" }>Active</option>
					<option value="inactive" selected?={ filter.Active == "inactive" }>Inactive</option>
				</select>
			</div>
		</div>
		<div id="customer-table">
			@Table(result, filter)
		</div>
	}
}
