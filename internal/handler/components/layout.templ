package components

templ Layout(pg PageContext, title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="stylesheet" href={ AssetVersion("/static/css/app.css") }/>
		<script src={ AssetVersion("/static/js/htmx.min.js") }></script>
		<script defer src={ AssetVersion("/static/js/alpine.min.js") }></script>
	</head>
	<body>
		if pg.User != nil {
			@Nav(*pg.User, pg.CompanyName)
		}
		<main class="container">
			if pg.Flash != "" {
				@FlashMessage(pg.Flash)
			}
			{ children... }
		</main>
		if pg.User != nil {
			@FeedbackButton()
		}
	</body>
	</html>
}
