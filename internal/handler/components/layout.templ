package components

// CSRFField renders a hidden input with the CSRF token for non-HTMX form submissions.
templ CSRFField(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}

templ Layout(pg PageContext, title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="icon" type="image/svg+xml" href={ pg.Brand.FaviconFile }/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"/>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"/>
		<link rel="stylesheet" href={ AssetVersion("/static/css/app.css") }/>
		<link rel="stylesheet" href={ AssetVersion("/static/css/tailwind.css") }/>
		<style>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
				vertical-align: middle;
			}
		</style>
		<script src={ AssetVersion("/static/js/htmx.min.js") }></script>
		<script defer src={ AssetVersion("/static/js/alpine.min.js") }></script>
		<script>
			document.addEventListener('htmx:configRequest', function(evt) {
				var match = document.cookie.match(/(?:^|; )csrf_token=([^;]*)/);
				if (match) {
					evt.detail.headers['X-CSRF-Token'] = match[1];
				}
			});
		</script>
		<script>
			// Shared customer-typeahead selection handler. Invoked from the
			// dropdown rows rendered by customers.SearchResults. Reads the
			// prefix from the results list and the customer payload from the
			// clicked row, then populates the hidden id + read-only detail
			// inputs. Handles the "prefixed" order-form fields (bill/load/drop)
			// as well as the single-customer payment/invoice/credit-memo forms.
			window.atlinksSelectCustomer = function (row) {
				var list = row.closest('.customer-search-results');
				var prefix = list ? (list.getAttribute('data-prefix') || '') : '';
				var customer;
				try { customer = JSON.parse(row.getAttribute('data-customer')); }
				catch (e) { return; }

				var p = prefix ? prefix + '_' : '';
				// Try the prefixed id first, then fall back to the bare id used
				// by the single-customer forms.
				function setField(value, ids) {
					for (var i = 0; i < ids.length; i++) {
						var el = document.getElementById(ids[i]);
						if (el) { el.value = value == null ? '' : value; return el; }
					}
					return null;
				}

				setField(customer.id, [p + 'customer_id', 'customer_id']);
				setField(customer.number, [p + 'customer_number', 'customer_number']);
				setField(customer.name, [p + 'customer_name', 'customer_name']);
				setField(customer.address, [p + 'to_address', p + 'address', 'bill_to_address']);
				setField(customer.address2, [p + 'to_address2', 'bill_to_address2']);
				setField(customer.city, [p + 'to_city', p + 'city', 'bill_to_city']);
				setField(customer.state, [p + 'to_state', p + 'state', 'bill_to_state']);
				setField(customer.zip, [p + 'to_zip', p + 'zip', 'bill_to_zip']);
				setField(customer.contact, [p + 'contact']);
				setField(customer.phone, [p + 'phone']);

				// Auto-fill order zones from the load/drop customer.
				if (customer.zone) {
					var zoneField = null;
					if (prefix === 'load') zoneField = document.getElementById('origin_zone');
					else if (prefix === 'drop') zoneField = document.getElementById('destination_zone');
					if (zoneField) {
						zoneField.value = customer.zone;
						zoneField.dispatchEvent(new Event('change', { bubbles: true }));
					}
				}

				// Reflect the chosen customer in the search box and close the
				// dropdown. The results container (list.parentElement) and the
				// search input are siblings inside the same .form-group.
				var group = list ? list.closest('.form-group') : null;
				if (group) {
					var searchInput = group.querySelector('input[placeholder="Type to search..."]');
					if (searchInput) searchInput.value = customer.name || '';
				}
				if (list && list.parentElement) {
					list.parentElement.innerHTML = '';
				}
			};
		</script>
	</head>
	<body class="bg-surface text-on-surface antialiased">
		if pg.User != nil {
			@Nav(*pg.User, pg.CompanyName, pg.Features, pg.Brand)
		}
		<main class="container">
			if pg.Suspended {
				<div class="alert alert-danger" style="margin-bottom:1rem;">
					&#128274; Your account is suspended. All data is in read-only mode. Contact your administrator to restore access.
				</div>
			}
			if pg.Flash != "" {
				@FlashMessage(pg.Flash)
			}
			{ children... }
		</main>
		if pg.User != nil {
			@FeedbackButton()
		}
	</body>
	</html>
}
