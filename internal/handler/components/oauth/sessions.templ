package oauth

import (
	"fmt"
	"time"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/store"
)

func lastChars(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return "..." + s[len(s)-n:]
}

func fmtTime(t time.Time) string {
	return t.Format("Jan 2, 2006 3:04 PM")
}

templ SessionsPage(pg components.PageContext, tokens []store.RefreshToken, flashMsg string) {
	@components.Layout(pg, "Active Sessions") {
		<div class="container">
			<div class="page-header">
				<h1>Active Sessions</h1>
				<p class="text-muted">Devices and applications authorized to access your account.</p>
			</div>
			if flashMsg != "" {
				<div class="alert alert-success">{ flashMsg }</div>
			}
			if len(tokens) == 0 {
				<div class="alert alert-info">No active sessions.</div>
			} else {
				<div class="table-responsive">
					<table class="table">
						<thead>
							<tr>
								<th>Client</th>
								<th>Created</th>
								<th>Expires</th>
								<th>Token</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, t := range tokens {
								<tr>
									<td>{ t.ClientID }</td>
									<td>{ fmtTime(t.CreatedAt) }</td>
									<td>{ fmtTime(t.ExpiresAt) }</td>
									<td><code>{ lastChars(t.TokenHash, 8) }</code></td>
									<td>
										<form method="POST" action="/settings/sessions/revoke" style="display:inline;">
											<input type="hidden" name="csrf_token" value={ pg.CSRFToken }/>
											<input type="hidden" name="token_id" value={ fmt.Sprintf("%d", t.ID) }/>
											<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Revoke this session?');">Revoke</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
