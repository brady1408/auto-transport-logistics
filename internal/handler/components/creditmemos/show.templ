package creditmemos

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ ShowPage(pg components.PageContext, creditMemo *models.CreditMemo) {
	@components.Layout(pg, "Credit Memo " + creditMemo.CreditNumber + " - ATLinks") {
		<div class="page-header">
			<h1>Credit Memo { creditMemo.CreditNumber }</h1>
			<div class="btn-group">
				<a href={ templ.SafeURL(fmt.Sprintf("/accounting/credit-memos/%d/edit", creditMemo.ID)) } class="btn">Edit</a>
				<button
					class="btn btn-danger"
					hx-delete={ fmt.Sprintf("/accounting/credit-memos/%d", creditMemo.ID) }
					hx-confirm={ fmt.Sprintf("Delete credit memo %s?", creditMemo.CreditNumber) }
				>Delete</button>
				<a href="/accounting/credit-memos" class="btn">Back to List</a>
			</div>
		</div>
		<div class="order-detail-grid">
			<div class="card">
				<div class="card-header">Credit Memo Info</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Status:</span>
						<span>
							@creditMemoStatusBadge(creditMemo.Status)
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Date:</span>
						<span>
							if creditMemo.CreditDate != nil {
								{ creditMemo.CreditDate.Format("01/02/2006") }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Amount:</span>
						<span><strong>${ components.Deref(creditMemo.Amount) }</strong></span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Reason:</span>
						<span>{ components.Deref(creditMemo.Reason) }</span>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">Customer &amp; Invoice</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Customer:</span>
						<span>
							{ components.Deref(creditMemo.CustomerName) }
							if creditMemo.CustomerNumber != nil {
								(#{ components.Deref(creditMemo.CustomerNumber) })
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Invoice:</span>
						<span>
							if creditMemo.InvoiceID != nil {
								<a href={ templ.SafeURL(fmt.Sprintf("/accounting/invoices/%d", components.DerefInt(creditMemo.InvoiceID))) }>{ components.Deref(creditMemo.InvoiceNumber) }</a>
							} else {
								{ components.Deref(creditMemo.InvoiceNumber) }
							}
						</span>
					</div>
				</div>
			</div>
		</div>
		if creditMemo.Comments != nil {
			<h2 class="section-title">Comments</h2>
			<div class="card">
				<div class="card-body">{ components.Deref(creditMemo.Comments) }</div>
			</div>
		}
	}
}
