package creditmemos

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ListPage(pg components.PageContext, result models.CreditMemoListResult, filter models.CreditMemoFilter) {
	@components.Layout(pg, "Credit Memos - ATLinks") {
		<div class="page-header">
			<h1>Credit Memos</h1>
			<a href="/accounting/credit-memos/new" class="btn btn-primary">New Credit Memo</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Credit #, customer, invoice..."
					value={ filter.Search }
					hx-get="/accounting/credit-memos"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#credit-memo-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="status">Status</label>
				<select
					id="status" name="status" class="form-control"
					hx-get="/accounting/credit-memos"
					hx-trigger="change"
					hx-target="#credit-memo-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="" selected?={ filter.Status == "" }>All</option>
					<option value="Pending" selected?={ filter.Status == "Pending" }>Pending</option>
					<option value="Applied" selected?={ filter.Status == "Applied" }>Applied</option>
					<option value="Void" selected?={ filter.Status == "Void" }>Void</option>
				</select>
			</div>
		</div>
		<div id="credit-memo-table">
			@Table(result)
		</div>
	}
}
