package components

import (
	"fmt"
	"strconv"

	"github.com/brady1408/auto-transport-logistics/internal/service"
)

// FMCSANotice renders an inline notice in the FMCSA panel. kind is an alert
// suffix: success, warning, or danger.
templ FMCSANotice(kind string, msg string) {
	<div class={ "alert", "alert-" + kind } style="margin-top:10px; margin-bottom:0;">{ msg }</div>
}

templ FMCSAResultPanel(v *service.CarrierVerification) {
	<div style="margin-top:10px; border:1px solid rgba(198,198,205,0.5); border-radius:8px; padding:14px 16px;">
		<div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px;">
			<strong>{ v.LegalName }</strong>
			if v.DBAName != "" {
				<span class="text-muted">DBA { v.DBAName }</span>
			}
			<span class="text-muted">USDOT# { strconv.Itoa(v.DOTNumber) }</span>
			@fmcsaOperatingBadge(v)
			@fmcsaSafetyBadge(v.SafetyRating)
		</div>
		<table style="font-size:13px; border-collapse:collapse;">
			<tr>
				<td class="text-muted" style="padding:2px 16px 2px 0;">Operating Authority</td>
				<td style="padding:2px 0;">
					Common: { v.CommonAuthority }
					&middot; Contract: { v.ContractAuthority }
					&middot; Broker: { v.BrokerAuthority }
				</td>
			</tr>
			<tr>
				<td class="text-muted" style="padding:2px 16px 2px 0;">Safety Rating</td>
				<td style="padding:2px 0;">
					{ v.SafetyRating }
					if v.SafetyRatingDate != "" {
						<span class="text-muted">(rated { v.SafetyRatingDate })</span>
					}
				</td>
			</tr>
			<tr>
				<td class="text-muted" style="padding:2px 16px 2px 0;">Insurance on File</td>
				<td style="padding:2px 0;">
					if v.BIPDInsuranceOnFile == "" && v.CargoInsuranceOnFile == "" && v.BondInsuranceOnFile == "" {
						None reported
					} else {
						if v.BIPDInsuranceOnFile != "" {
							BIPD { v.BIPDInsuranceOnFile }
							if v.BIPDInsuranceReqd != "" {
								<span class="text-muted">(required { v.BIPDInsuranceReqd })</span>
							}
						}
						if v.CargoInsuranceOnFile != "" {
							&middot; Cargo { v.CargoInsuranceOnFile }
						}
						if v.BondInsuranceOnFile != "" {
							&middot; Bond { v.BondInsuranceOnFile }
						}
					}
				</td>
			</tr>
			if v.OutOfService {
				<tr>
					<td class="text-muted" style="padding:2px 16px 2px 0;">Out of Service</td>
					<td style="padding:2px 0;">Since { v.OutOfServiceDate }</td>
				</tr>
			}
			if v.TotalPowerUnits > 0 || v.TotalDrivers > 0 {
				<tr>
					<td class="text-muted" style="padding:2px 16px 2px 0;">Fleet</td>
					<td style="padding:2px 0;">{ fmt.Sprintf("%d power units · %d drivers", v.TotalPowerUnits, v.TotalDrivers) }</td>
				</tr>
			}
		</table>
		<p class="text-muted" style="font-size:12px; margin:10px 0 0;">
			Source: FMCSA
			if v.SnapshotDate != "" {
				&middot; data as of { v.SnapshotDate }
			}
			&middot; verified { v.VerifiedAt.Format("Jan 2, 2006 3:04 PM") }
		</p>
	</div>
}

templ fmcsaOperatingBadge(v *service.CarrierVerification) {
	if v.OutOfService {
		<span class="badge badge-denied">Out of Service</span>
	} else if v.AllowedToOperate {
		<span class="badge badge-confirmed">Authorized</span>
	} else {
		<span class="badge badge-waiting">Not Authorized</span>
	}
}

templ fmcsaSafetyBadge(rating string) {
	switch rating {
		case "Satisfactory":
			<span class="badge badge-active">Satisfactory</span>
		case "Conditional":
			<span class="badge badge-waiting">Conditional</span>
		case "Unsatisfactory":
			<span class="badge badge-denied">Unsatisfactory</span>
		default:
			<span class="badge badge-inactive">{ rating }</span>
	}
}
