package feedback

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

func truncateMessage(s string, max int) string {
	if len(s) > max {
		return s[:max] + "..."
	}
	return s
}

templ Table(result models.FeedbackListResult, isSuperAdmin bool) {
	<div class="table-container">
		<table>
			<thead>
				<tr>
					<th>Date</th>
					<th>User</th>
					if isSuperAdmin {
						<th>Company</th>
					}
					<th>Category</th>
					<th>Page</th>
					<th>Message</th>
					<th>Status</th>
					<th>Comments</th>
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				if len(result.Items) > 0 {
					for _, fb := range result.Items {
						<tr>
							<td>{ fb.CreatedAt.Format("01/02/2006 3:04 PM") }</td>
							<td>{ fb.Username }</td>
							if isSuperAdmin {
								<td>{ fb.CompanyName }</td>
							}
							<td>
								if fb.Category == "bug" {
									<span class="badge badge-denied">Bug</span>
								} else if fb.Category == "feature" {
									<span class="badge badge-scheduled">Feature</span>
								} else {
									<span class="badge badge-pending">Question</span>
								}
							</td>
							<td><code>{ fb.PageURL }</code></td>
							<td>{ truncateMessage(fb.Message, 80) }</td>
							<td>
								if fb.Status == "open" {
									<span class="badge badge-open">Open</span>
								} else if fb.Status == "reviewed" {
									<span class="badge badge-pending">Reviewed</span>
								} else if fb.Status == "resolved" {
									<span class="badge badge-paid">Resolved</span>
								} else if fb.Status == "closed" {
									<span class="badge badge-inactive">Closed</span>
								} else {
									<span class="badge">{ fb.Status }</span>
								}
							</td>
							<td class="text-center">{ fmt.Sprintf("%d", fb.CommentCount) }</td>
							<td class="text-right">
								<a href={ templ.SafeURL(fmt.Sprintf("/feedback/%d", fb.ID)) } class="btn btn-sm">View</a>
							</td>
						</tr>
					}
				} else {
					<tr>
						<td
							colspan={
								func() string {
									if isSuperAdmin {
										return "10"
									}
									return "9"
								}()
							}
							class="text-center text-muted"
						>No feedback found</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	if len(result.Items) > 0 {
		@components.Pagination(components.NewPaginationData(
			result.Page, result.PageSize, result.TotalCount,
			"/feedback", "#feedback-table",
		))
	}
}
