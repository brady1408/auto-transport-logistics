package feedback

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ListPage(pg components.PageContext, result models.FeedbackListResult, filter models.FeedbackFilter, isSuperAdmin bool) {
	@components.Layout(pg, "Feedback - ATLinks") {
		<div class="page-header">
			<h1>Feedback</h1>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="status">Status</label>
				<select
					id="status" name="status" class="form-control"
					hx-get="/feedback"
					hx-trigger="change"
					hx-target="#feedback-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="active" selected?={ filter.Status == "active" }>Active</option>
					<option value="all" selected?={ filter.Status == "all" }>All</option>
					<option value="open" selected?={ filter.Status == "open" }>Open</option>
					<option value="reviewed" selected?={ filter.Status == "reviewed" }>Reviewed</option>
					<option value="resolved" selected?={ filter.Status == "resolved" }>Resolved</option>
					<option value="closed" selected?={ filter.Status == "closed" }>Closed</option>
				</select>
			</div>
			<div class="form-group">
				<label for="category">Category</label>
				<select
					id="category" name="category" class="form-control"
					hx-get="/feedback"
					hx-trigger="change"
					hx-target="#feedback-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="" selected?={ filter.Category == "" }>All</option>
					<option value="bug" selected?={ filter.Category == "bug" }>Bug</option>
					<option value="feature" selected?={ filter.Category == "feature" }>Feature</option>
					<option value="question" selected?={ filter.Category == "question" }>Question</option>
				</select>
			</div>
		</div>
		<div id="feedback-table">
			@Table(result, isSuperAdmin)
		</div>
	}
}
