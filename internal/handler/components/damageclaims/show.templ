package damageclaims

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/handler/components/attachments"
	"github.com/brady1408/atlinks/internal/models"
)

templ ShowPage(pg components.PageContext, claim *models.DamageClaim, atts []models.Attachment) {
	@components.Layout(pg, "Damage Claim " + claim.ClaimNumber + " - ATLinks") {
		<div class="page-header">
			<h1>Damage Claim { claim.ClaimNumber }</h1>
			<div class="btn-group">
				<a href={ templ.SafeURL(fmt.Sprintf("/accounting/damage-claims/%d/edit", claim.ID)) } class="btn">Edit</a>
				<button
					class="btn btn-danger"
					hx-delete={ fmt.Sprintf("/accounting/damage-claims/%d", claim.ID) }
					hx-confirm={ fmt.Sprintf("Delete claim %s?", claim.ClaimNumber) }
				>Delete</button>
				<a href="/accounting/damage-claims" class="btn">Back to List</a>
			</div>
		</div>
		<div class="order-detail-grid">
			<div class="card">
				<div class="card-header">Claim Info</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Status:</span>
						<span>
							@claimStatusBadge(claim.Status)
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Claim Date:</span>
						<span>
							if claim.ClaimDate != nil {
								{ claim.ClaimDate.Format("01/02/2006") }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Claim Amount:</span>
						<span>${ components.Deref(claim.ClaimAmount) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Paid Amount:</span>
						<span>${ components.Deref(claim.PaidAmount) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">VIN:</span>
						<span>{ components.Deref(claim.VIN) }</span>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">References</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Order:</span>
						<span>
							if claim.OrderID != nil {
								<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/orders/%d", components.DerefInt(claim.OrderID))) }>Order #{ fmt.Sprintf("%d", components.DerefInt(claim.OrderID)) }</a>
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Vehicle ID:</span>
						<span>{ fmt.Sprintf("%d", components.DerefInt(claim.VehicleID)) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Trip:</span>
						<span>
							if claim.TripID != nil {
								<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d", components.DerefInt(claim.TripID))) }>Trip #{ fmt.Sprintf("%d", components.DerefInt(claim.TripID)) }</a>
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Insurance:</span>
						<span>
							if claim.InsuranceClaim {
								Yes -- #{ components.Deref(claim.InsuranceClaimNumber) }
							} else {
								No
							}
						</span>
					</div>
				</div>
			</div>
		</div>
		if claim.Description != nil {
			<h2 class="section-title">Description</h2>
			<div class="card">
				<div class="card-body">{ components.Deref(claim.Description) }</div>
			</div>
		}
		if claim.Resolution != nil {
			<h2 class="section-title">Resolution</h2>
			<div class="card">
				<div class="card-body">
					{ components.Deref(claim.Resolution) }
					if claim.ResolvedDate != nil {
						<br/>
						<em>Resolved: { claim.ResolvedDate.Format("01/02/2006") }</em>
					}
				</div>
			</div>
		}
		<div id="damage-photos-section">
			<h2 class="section-title">Damage Photos</h2>
			@attachments.AttachmentGallery(atts, "damage_claim", claim.ID)
			<div class="card" style="margin-top: 8px;">
				<div class="card-body">
					<form
						hx-post={ fmt.Sprintf("/accounting/damage-claims/%d/attachments", claim.ID) }
						hx-target="#attachment-gallery"
						hx-swap="outerHTML"
						hx-encoding="multipart/form-data"
						hx-on::after-request="if(event.detail.successful) this.reset()"
					>
						<div style="display: flex; align-items: center; gap: 12px;">
							<input type="file" name="file" accept="image/*" required/>
							<button type="submit" class="btn btn-sm btn-primary">Upload Photo</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}
