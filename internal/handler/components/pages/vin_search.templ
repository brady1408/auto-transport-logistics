package pages

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/store"
)

templ VinSearchPage(pg components.PageContext, query string, results []store.GlobalSearchResult) {
	@components.Layout(pg, "VIN Search - ATLinks") {
		<div class="page-header">
			<h1>VIN Search</h1>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<input
					type="text" class="form-control search-input" name="q" value={ query }
					placeholder="Search by VIN, order number, or customer..."
					hx-get="/search/vin"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#vin-results"
					hx-push-url="true"
					hx-include="this"
					autofocus
				/>
			</div>
		</div>
		<div id="vin-results">
			@VinSearchResults(query, results)
		</div>
	}
}

templ VinSearchResults(query string, results []store.GlobalSearchResult) {
	if query != "" {
		<div class="table-container">
			<table>
				<thead>
					<tr>
						<th>VIN</th>
						<th>Year/Make/Model</th>
						<th>Status</th>
						<th>Order #</th>
						<th>Customer</th>
						<th>Load #</th>
						<th>Invoice #</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					if len(results) > 0 {
						for _, r := range results {
							<tr>
								<td><strong>{ r.VIN }</strong></td>
								<td>{ r.Year } { r.Make } { r.Model }</td>
								<td>
									if r.Status == "Waiting" {
										<span class="badge badge-waiting">Waiting</span>
									} else if r.Status == "Scheduled" {
										<span class="badge badge-scheduled">Scheduled</span>
									} else if r.Status == "Loaded" {
										<span class="badge badge-loaded">Loaded</span>
									} else if r.Status == "Delivered" {
										<span class="badge badge-delivered">Delivered</span>
									} else if r.Status == "Confirmed" {
										<span class="badge badge-confirmed">Confirmed</span>
									} else {
										<span class="badge">{ r.Status }</span>
									}
								</td>
								<td>
									if r.OrderNumber != "" {
										<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/orders/%d", r.OrderID)) }>{ r.OrderNumber }</a>
									}
								</td>
								<td>{ r.CustomerName }</td>
								<td>
									if r.LoadNumber != "" && r.TripID != nil {
										<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d", *r.TripID)) }>{ r.LoadNumber }</a>
									} else {
										{ r.LoadNumber }
									}
								</td>
								<td>
									if r.InvoiceNumber != "" && r.InvoiceID != nil {
										<a href={ templ.SafeURL(fmt.Sprintf("/accounting/invoices/%d", *r.InvoiceID)) }>{ r.InvoiceNumber }</a>
									} else {
										{ r.InvoiceNumber }
									}
								</td>
								<td>
									<div class="btn-group">
										<a href={ templ.SafeURL(fmt.Sprintf("/reports/vehicle-history?vin=%s", r.VIN)) } class="btn btn-sm">History</a>
									</div>
								</td>
							</tr>
						}
					} else {
						<tr>
							<td colspan="8" class="text-center text-muted">No vehicles found matching "{ query }"</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	} else {
		<p class="text-muted">Enter a VIN, order number, or customer name to search.</p>
	}
}
