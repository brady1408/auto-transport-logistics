package pages

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/store"
)

templ DashboardPage(pg components.PageContext, orderCounts store.OrderDashboardCounts, aging store.AgingBucket, tripCounts store.TripDashboardCounts, expiringTrucks []store.ExpiringTruck) {
	@components.Layout(pg, "ATLinks - Dashboard") {
		<div class="page-header">
			<h1>Dashboard</h1>
		</div>
		<div class="kpi-grid">
			<div class="kpi-card">
				<div class="kpi-value">{ fmt.Sprintf("%d", orderCounts.Active) }</div>
				<div class="kpi-label">Active Orders</div>
				<a href="/dispatch/orders?active=active" class="kpi-link">View Orders</a>
			</div>
			<div class="kpi-card kpi-warning">
				<div class="kpi-value">{ fmt.Sprintf("%d", orderCounts.UninvoicedDelivered) }</div>
				<div class="kpi-label">Uninvoiced Delivered</div>
				<a href="/dispatch/orders?active=active&status=uninvoiced_delivered" class="kpi-link">Review</a>
			</div>
			<div class="kpi-card">
				<div class="kpi-value">{ fmt.Sprintf("%d", aging.Count) }</div>
				<div class="kpi-label">Open Invoices</div>
				<a href="/accounting/invoices?status=Open" class="kpi-link">View Invoices</a>
			</div>
			<div class="kpi-card">
				<div class="kpi-value">{ fmt.Sprintf("%d", tripCounts.Active) }</div>
				<div class="kpi-label">Active Trips</div>
				<a href="/dispatch/trips?active=active" class="kpi-link">View Trips</a>
			</div>
		</div>
		if len(expiringTrucks) > 0 {
			<div class="card" style="margin-bottom: 1.5rem;">
				<div class="card-header" style="color:var(--danger)">&#9888; Truck Expirations (within 60 days)</div>
				<div class="card-body">
					<table>
						<tbody>
							for _, t := range expiringTrucks {
								<tr>
									<td><a href={ templ.SafeURL(fmt.Sprintf("/global/trucks/%d/edit", t.TruckID)) }>{ t.TruckNumber }</a></td>
									<td>{ t.ExpType }</td>
									<td>
										if t.DaysUntilExp < 0 {
											<span class="badge badge-inactive">EXPIRED { fmt.Sprintf("%d days ago", -t.DaysUntilExp) }</span>
										} else {
											<span class="badge" style="background:var(--warning,#f59e0b);color:#fff">{ t.ExpDate.Format("Jan 2, 2006") } ({ fmt.Sprintf("%d days", t.DaysUntilExp) })</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
		<div class="dashboard-grid">
			<div class="card">
				<div class="card-header">AR Aging Summary</div>
				<div class="card-body">
					<div class="table-container">
					<table>
						<thead>
							<tr>
								<th>Current (0-30)</th>
								<th>31-60 Days</th>
								<th>61-90 Days</th>
								<th>90+ Days</th>
								<th>Total</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>${ aging.Current }</td>
								<td>${ aging.Days31 }</td>
								<td>${ aging.Days61 }</td>
								<td>${ aging.Days90 }</td>
								<td><strong>${ aging.Total }</strong></td>
							</tr>
						</tbody>
					</table>
					</div>
					<div style="margin-top: 8px; text-align: right;">
						<a href="/reports/ar-aging" class="btn btn-sm">Full AR Aging Report</a>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">Quick Links</div>
				<div class="card-body">
					<ul class="quick-links">
						<li><a href="/dispatch/orders/new">New Order</a></li>
						<li><a href="/search/vin">VIN Search</a></li>
						<li><a href="/reports">Reports</a></li>
						<li><a href="/global/customers">Manage Customers</a></li>
						<li><a href="/utilities/company">Company Settings</a></li>
					</ul>
				</div>
			</div>
		</div>
	}
}
