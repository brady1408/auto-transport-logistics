package pages

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/store"
)

templ DashboardPage(pg components.PageContext, orderCounts store.OrderDashboardCounts, aging store.AgingBucket, tripCounts store.TripDashboardCounts, expiringTrucks []store.ExpiringTruck) {
	@components.Layout(pg, "Dashboard") {
		<div class="space-y-8">
			<!-- KPI Section -->
			<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
				<!-- Active Orders -->
				<a href="/dispatch/orders?active=active" class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow no-underline group">
					<p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Active Orders</p>
					<h3 class="text-2xl font-extrabold text-slate-900" style="font-family: 'Manrope', sans-serif;">{ fmt.Sprintf("%d", orderCounts.Active) }</h3>
					<p class="text-[11px] text-slate-400 mt-2 font-medium group-hover:text-primary-container transition-colors">View Orders →</p>
				</a>
				<!-- Uninvoiced Delivered -->
				<a href="/dispatch/orders?active=active&status=uninvoiced_delivered" class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow no-underline group">
					<p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Uninvoiced Delivered</p>
					<h3 class="text-2xl font-extrabold text-slate-900" style="font-family: 'Manrope', sans-serif;">{ fmt.Sprintf("%d", orderCounts.UninvoicedDelivered) }</h3>
					if orderCounts.UninvoicedDelivered > 0 {
						<p class="text-[11px] text-error font-semibold mt-2">Needs attention</p>
					} else {
						<p class="text-[11px] text-on-tertiary-container font-semibold mt-2">All clear</p>
					}
				</a>
				<!-- Open Invoices -->
				<a href="/accounting/invoices?status=Open" class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow no-underline group">
					<p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Open Invoices</p>
					<h3 class="text-2xl font-extrabold text-slate-900" style="font-family: 'Manrope', sans-serif;">{ fmt.Sprintf("%d", aging.Count) }</h3>
					<p class="text-[11px] text-slate-400 mt-2 font-medium group-hover:text-primary-container transition-colors">View Invoices →</p>
				</a>
				<!-- Active Trips -->
				<a href="/dispatch/trips?active=active" class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow no-underline group">
					<p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Active Trips</p>
					<h3 class="text-2xl font-extrabold text-slate-900" style="font-family: 'Manrope', sans-serif;">{ fmt.Sprintf("%d", tripCounts.Active) }</h3>
					<div class="w-full bg-surface-container-low h-1 rounded-full mt-4">
						if tripCounts.Active > 0 {
							<div class="bg-primary-container h-1 rounded-full" style="width: 75%"></div>
						}
					</div>
				</a>
			</section>
			<!-- Truck Expirations Alert -->
			if len(expiringTrucks) > 0 {
				<section class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/10 shadow-sm">
					<h2 class="text-lg font-bold tracking-tight text-slate-900 mb-4 flex items-center gap-2" style="font-family: 'Manrope', sans-serif;">
						<span class="material-symbols-outlined text-error">warning</span>
						Truck Expirations
						<span class="text-xs font-medium text-slate-400 ml-1">(within 60 days)</span>
					</h2>
					<div class="space-y-3">
						for _, t := range expiringTrucks {
							<div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low/50">
								<span class="material-symbols-outlined text-slate-400">local_shipping</span>
								<div class="flex-1">
									<a href={ templ.SafeURL(fmt.Sprintf("/global/trucks/%d/edit", t.TruckID)) } class="text-sm font-bold text-slate-900 no-underline hover:underline">{ t.TruckNumber }</a>
									<span class="text-xs text-slate-500 ml-2">{ t.ExpType }</span>
								</div>
								<div>
									if t.DaysUntilExp < 0 {
										<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-error-container text-on-error-container">
											EXPIRED { fmt.Sprintf("%d days ago", -t.DaysUntilExp) }
										</span>
									} else {
										<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
											{ t.ExpDate.Format("Jan 2, 2006") } ({ fmt.Sprintf("%d days", t.DaysUntilExp) })
										</span>
									}
								</div>
							</div>
						}
					</div>
				</section>
			}
			<!-- Middle Section: AR Aging + Quick Actions -->
			<section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- AR Aging Summary -->
				<div class="lg:col-span-2 bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/10 shadow-sm">
					<div class="flex items-center justify-between mb-6">
						<h2 class="text-lg font-bold tracking-tight text-slate-900" style="font-family: 'Manrope', sans-serif;">AR Aging Summary</h2>
						<a href="/reports/ar-aging" class="text-xs font-semibold text-on-primary-container underline underline-offset-4 no-underline hover:underline">Full Report</a>
					</div>
					<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
						<div class="p-4 bg-surface rounded-xl">
							<p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-1">0-30 Days</p>
							<p class="text-xl font-bold text-slate-900" style="font-family: 'Manrope', sans-serif;">${ aging.Current }</p>
						</div>
						<div class="p-4 bg-surface rounded-xl">
							<p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-1">31-60 Days</p>
							<p class="text-xl font-bold text-slate-900" style="font-family: 'Manrope', sans-serif;">${ aging.Days31 }</p>
						</div>
						<div class="p-4 bg-surface rounded-xl border-l-4 border-amber-400">
							<p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-1">61-90 Days</p>
							<p class="text-xl font-bold text-slate-900" style="font-family: 'Manrope', sans-serif;">${ aging.Days61 }</p>
						</div>
						<div class="p-4 bg-surface rounded-xl border-l-4 border-error">
							<p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-1">90+ Days</p>
							<p class="text-xl font-bold text-error" style="font-family: 'Manrope', sans-serif;">${ aging.Days90 }</p>
						</div>
						<div class="p-4 bg-primary-container/5 rounded-xl">
							<p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-1">Total</p>
							<p class="text-xl font-bold text-slate-900" style="font-family: 'Manrope', sans-serif;">${ aging.Total }</p>
						</div>
					</div>
				</div>
				<!-- Quick Actions -->
				<div class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/10 shadow-sm flex flex-col">
					<h2 class="text-lg font-bold tracking-tight text-slate-900 mb-6" style="font-family: 'Manrope', sans-serif;">Quick Actions</h2>
					<div class="space-y-2 flex-1">
						<a href="/dispatch/orders/new" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors no-underline text-slate-700">
							<div class="w-8 h-8 rounded-lg bg-primary-container/10 flex items-center justify-center">
								<span class="material-symbols-outlined text-on-primary-container text-[18px]">add_circle</span>
							</div>
							<span class="text-sm font-medium">New Order</span>
						</a>
						<a href="/search/vin" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors no-underline text-slate-700">
							<div class="w-8 h-8 rounded-lg bg-primary-container/10 flex items-center justify-center">
								<span class="material-symbols-outlined text-on-primary-container text-[18px]">search</span>
							</div>
							<span class="text-sm font-medium">VIN Search</span>
						</a>
						<a href="/reports" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors no-underline text-slate-700">
							<div class="w-8 h-8 rounded-lg bg-primary-container/10 flex items-center justify-center">
								<span class="material-symbols-outlined text-on-primary-container text-[18px]">assessment</span>
							</div>
							<span class="text-sm font-medium">Reports</span>
						</a>
						<a href="/global/customers" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors no-underline text-slate-700">
							<div class="w-8 h-8 rounded-lg bg-primary-container/10 flex items-center justify-center">
								<span class="material-symbols-outlined text-on-primary-container text-[18px]">people</span>
							</div>
							<span class="text-sm font-medium">Manage Customers</span>
						</a>
						<a href="/utilities/company" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors no-underline text-slate-700">
							<div class="w-8 h-8 rounded-lg bg-primary-container/10 flex items-center justify-center">
								<span class="material-symbols-outlined text-on-primary-container text-[18px]">settings</span>
							</div>
							<span class="text-sm font-medium">Company Settings</span>
						</a>
					</div>
				</div>
			</section>
		</div>
	}
}
