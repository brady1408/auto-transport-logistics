package invoices

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

// DetailTable renders the invoice line items. When locked is true (posted, paid,
// or void invoice) the per-line Remove buttons are replaced with a lock note,
// since posted invoices are immutable and must be adjusted via a credit memo.
templ DetailTable(details []models.InvoiceDetail, invoiceID int, locked bool) {
	<div class="table-container">
		<table>
			<thead>
				<tr>
					<th>Description</th>
					<th>VIN</th>
					<th>Year/Make/Model</th>
					<th class="text-right">Qty</th>
					<th class="text-right">Rate</th>
					<th class="text-right">Amount</th>
					<th class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				if len(details) > 0 {
					for _, d := range details {
						<tr>
							<td>{ components.Deref(d.Description) }</td>
							<td>{ components.Deref(d.VIN) }</td>
							<td>{ components.Deref(d.Year) } { components.Deref(d.Make) } { components.Deref(d.Model) }</td>
							<td class="text-right">{ fmt.Sprintf("%d", components.DerefInt(d.Qty)) }</td>
							<td class="text-right">{ components.Money(d.Rate) }</td>
							<td class="text-right">{ components.Money(d.Amount) }</td>
							<td class="text-right">
								if !locked {
									<button
										class="btn btn-sm btn-danger"
										hx-delete={ fmt.Sprintf("/accounting/invoice-details/%d", d.ID) }
										hx-target="#invoice-detail-table"
										hx-swap="innerHTML"
										hx-confirm="Remove this line item?"
									>Remove</button>
								}
							</td>
						</tr>
					}
				} else {
					<tr><td colspan="7" class="text-center text-muted">No line items</td></tr>
				}
			</tbody>
		</table>
		if locked {
			<p class="text-muted" style="margin-top:0.5rem;">
				<span class="material-symbols-outlined" style="font-size:16px;">lock</span>
				Posted — lines locked; use a credit memo to adjust.
			</p>
		}
	</div>
}
