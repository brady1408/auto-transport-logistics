package invoices

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ PrintPage(invoice *models.Invoice, details []models.InvoiceDetail) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>Invoice { invoice.InvoiceNumber }</title>
			@printStyles()
		</head>
		<body>
			<div class="invoice-header">
				<div>
					<div class="company-name">ATLinks</div>
					<div>Vehicle Transport Services</div>
				</div>
				<div>
					<div class="invoice-title">INVOICE</div>
					<div class="invoice-meta">
						<div><span class="label">Invoice #:</span> <strong>{ invoice.InvoiceNumber }</strong></div>
						<div>
							<span class="label">Date:</span>
							if invoice.InvoiceDate != nil {
								{ invoice.InvoiceDate.Format("01/02/2006") }
							}
						</div>
						if invoice.DueDate != nil {
							<div><span class="label">Due:</span> { invoice.DueDate.Format("01/02/2006") }</div>
						}
						if invoice.OrderNumber != nil {
							<div><span class="label">Order #:</span> { components.Deref(invoice.OrderNumber) }</div>
						}
						if invoice.Terms != nil {
							<div><span class="label">Terms:</span> { components.Deref(invoice.Terms) }</div>
						}
					</div>
				</div>
			</div>
			<div class="bill-to">
				<div class="bill-to-title">Bill To</div>
				<strong>{ components.Deref(invoice.CustomerName) }</strong>
				if invoice.BillToAddress != nil {
					<br/>
					{ components.Deref(invoice.BillToAddress) }
				}
				if invoice.BillToAddress2 != nil {
					<br/>
					{ components.Deref(invoice.BillToAddress2) }
				}
				if invoice.BillToCity != nil {
					<br/>
					{ components.Deref(invoice.BillToCity) }, { components.Deref(invoice.BillToState) } { components.Deref(invoice.BillToZip) }
				}
			</div>
			<table>
				<thead>
					<tr>
						<th>Description</th>
						<th>VIN</th>
						<th>Year/Make/Model</th>
						<th class="text-right">Qty</th>
						<th class="text-right">Rate</th>
						<th class="text-right">Amount</th>
					</tr>
				</thead>
				<tbody>
					for _, d := range details {
						<tr>
							<td>{ components.Deref(d.Description) }</td>
							<td>{ components.Deref(d.VIN) }</td>
							<td>{ components.Deref(d.Year) } { components.Deref(d.Make) } { components.Deref(d.Model) }</td>
							<td class="text-right">{ fmt.Sprintf("%d", components.DerefInt(d.Qty)) }</td>
							<td class="text-right">{ components.Deref(d.Rate) }</td>
							<td class="text-right">{ components.Deref(d.Amount) }</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="clearfix">
				<div class="totals">
					<table>
						<tr>
							<td>Subtotal:</td>
							<td class="text-right">${ components.Deref(invoice.Subtotal) }</td>
						</tr>
						<tr>
							<td>Tax:</td>
							<td class="text-right">${ components.Deref(invoice.Tax) }</td>
						</tr>
						<tr class="total-row">
							<td>Total:</td>
							<td class="text-right">${ components.Deref(invoice.TotalAmount) }</td>
						</tr>
						<tr>
							<td>Amount Paid:</td>
							<td class="text-right">${ components.Deref(invoice.AmountPaid) }</td>
						</tr>
						<tr class="total-row">
							<td>Balance Due:</td>
							<td class="text-right">${ components.Deref(invoice.Balance) }</td>
						</tr>
					</table>
				</div>
			</div>
			if invoice.Comments != nil {
				<div style="margin-top: 40px; clear: both;">
					<strong>Notes:</strong><br/>
					{ components.Deref(invoice.Comments) }
				</div>
			}
			<script>window.print();</script>
		</body>
	</html>
}

templ printStyles() {
	<style>
		body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 12px; color: #333; margin: 40px; }
		.invoice-header { display: flex; justify-content: space-between; margin-bottom: 30px; }
		.company-name { font-size: 24px; font-weight: 700; color: #2563eb; }
		.invoice-title { font-size: 28px; font-weight: 700; color: #333; text-align: right; }
		.invoice-meta { text-align: right; margin-top: 8px; }
		.invoice-meta div { margin-bottom: 4px; }
		.invoice-meta .label { color: #666; }
		.bill-to { margin-bottom: 30px; }
		.bill-to-title { font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; margin-bottom: 4px; }
		table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
		th { background: #f3f4f6; padding: 8px 12px; text-align: left; font-size: 11px; font-weight: 600; border-bottom: 2px solid #e5e7eb; }
		td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; }
		.text-right { text-align: right; }
		.totals { float: right; width: 250px; }
		.totals table { margin-bottom: 0; }
		.totals td { border: none; padding: 4px 8px; }
		.totals .total-row { font-weight: 700; font-size: 14px; border-top: 2px solid #333; }
		.clearfix::after { content: ""; display: table; clear: both; }
		@media print {
			body { margin: 20px; }
			@page { margin: 1cm; }
		}
	</style>
}
