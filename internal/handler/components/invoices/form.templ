package invoices

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ FormPage(pg components.PageContext, invoice *models.Invoice, isNew bool, errMsg string) {
	@components.Layout(pg, invoiceFormTitle(isNew, invoice) + " - ATLinks") {
		<div class="page-header">
			<h1>
				if isNew {
					New Invoice
				} else {
					Edit Invoice: { invoice.InvoiceNumber }
				}
			</h1>
			<a href="/accounting/invoices" class="btn">Back to List</a>
		</div>
		if errMsg != "" {
			<div class="alert alert-danger">{ errMsg }</div>
		}
		<form
			method="POST"
			if isNew {
				action="/accounting/invoices"
				hx-post="/accounting/invoices"
			} else {
				action={ templ.SafeURL(fmt.Sprintf("/accounting/invoices/%d/edit", invoice.ID)) }
				hx-put={ fmt.Sprintf("/accounting/invoices/%d", invoice.ID) }
			}
			x-data="invoiceForm()"
		>
			@components.CSRFField(pg.CSRFToken)
			<fieldset>
				<legend>Invoice Information</legend>
				<div class="form-row">
					<div class="form-group">
						<label for="invoice_number">Invoice Number</label>
						<input
							type="text" id="invoice_number" name="invoice_number" class="form-control"
							value={ invoice.InvoiceNumber }
							if !isNew {
								readonly
							}
						/>
					</div>
					<div class="form-group">
						<label for="status">Status</label>
						<select id="status" name="status" class="form-control">
							<option value="Open" selected?={ components.Deref(invoice.Status) == "Open" }>Open</option>
							<option value="Paid" selected?={ components.Deref(invoice.Status) == "Paid" }>Paid</option>
							<option value="Void" selected?={ components.Deref(invoice.Status) == "Void" }>Void</option>
						</select>
					</div>
					<div class="form-group">
						<label for="invoice_date">Invoice Date</label>
						<input type="date" id="invoice_date" name="invoice_date" class="form-control" value={ components.FormatDate(invoice.InvoiceDate) }/>
					</div>
					<div class="form-group">
						<label for="due_date">Due Date</label>
						<input type="date" id="due_date" name="due_date" class="form-control" value={ components.FormatDate(invoice.DueDate) }/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="terms">Terms</label>
						<input type="text" id="terms" name="terms" class="form-control" value={ components.Deref(invoice.Terms) } maxlength="20"/>
					</div>
					<div class="form-group">
						<label for="tax_code">Tax Code</label>
						<input type="text" id="tax_code" name="tax_code" class="form-control" value={ components.Deref(invoice.TaxCode) } maxlength="20"/>
					</div>
					<div class="form-group">
						<label for="order_number">Order #</label>
						<input type="text" id="order_number" name="order_number" class="form-control" value={ components.Deref(invoice.OrderNumber) } maxlength="10"/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Customer</legend>
				<div class="form-row">
					<div class="form-group col-span-2">
						<label for="bill_customer_search">Search Customer</label>
						<input
							type="text" id="bill_customer_search" class="form-control"
							placeholder="Type to search..."
							autocomplete="off"
							hx-get="/api/customers/search"
							hx-trigger="keyup changed delay:300ms"
							hx-target="#inv_customer_results"
							hx-params="*"
							{ atInput()... }
						/>
						<div id="inv_customer_results" class="search-results"></div>
						<input type="hidden" id="customer_id" name="customer_id" value={ fmt.Sprintf("%d", components.DerefInt(invoice.CustomerID)) }/>
					</div>
					<div class="form-group">
						<label for="customer_number">Customer #</label>
						<input type="text" id="customer_number" name="customer_number" class="form-control" value={ components.Deref(invoice.CustomerNumber) } maxlength="10"/>
					</div>
					<div class="form-group">
						<label for="customer_name">Name</label>
						<input type="text" id="customer_name" name="customer_name" class="form-control" value={ components.Deref(invoice.CustomerName) } maxlength="30"/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group col-span-2">
						<label for="bill_to_address">Address</label>
						<input type="text" id="bill_to_address" name="bill_to_address" class="form-control" value={ components.Deref(invoice.BillToAddress) } maxlength="30"/>
					</div>
					<div class="form-group col-span-2">
						<label for="bill_to_address2">Address 2</label>
						<input type="text" id="bill_to_address2" name="bill_to_address2" class="form-control" value={ components.Deref(invoice.BillToAddress2) } maxlength="30"/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="bill_to_city">City</label>
						<input type="text" id="bill_to_city" name="bill_to_city" class="form-control" value={ components.Deref(invoice.BillToCity) } maxlength="25"/>
					</div>
					<div class="form-group">
						<label for="bill_to_state">State</label>
						<input type="text" id="bill_to_state" name="bill_to_state" class="form-control" value={ components.Deref(invoice.BillToState) } maxlength="2"/>
					</div>
					<div class="form-group">
						<label for="bill_to_zip">Zip</label>
						<input type="text" id="bill_to_zip" name="bill_to_zip" class="form-control" value={ components.Deref(invoice.BillToZip) } maxlength="10"/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Totals</legend>
				<div class="form-row">
					<div class="form-group">
						<label for="subtotal">Subtotal</label>
						<input type="text" id="subtotal" name="subtotal" class="form-control" value={ components.Deref(invoice.Subtotal) }/>
					</div>
					<div class="form-group">
						<label for="tax">Tax</label>
						<input type="text" id="tax" name="tax" class="form-control" value={ components.Deref(invoice.Tax) }/>
					</div>
					<div class="form-group">
						<label for="total_amount">Total</label>
						<input type="text" id="total_amount" name="total_amount" class="form-control" value={ components.Deref(invoice.TotalAmount) }/>
					</div>
					<div class="form-group">
						<label for="balance">Balance</label>
						<input type="text" id="balance" name="balance" class="form-control" value={ components.Deref(invoice.Balance) } readonly/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Comments</legend>
				<div class="form-group">
					<textarea id="comments" name="comments" class="form-control">{ components.Deref(invoice.Comments) }</textarea>
				</div>
			</fieldset>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					if isNew {
						Create Invoice
					} else {
						Save Changes
					}
				</button>
				<a href="/accounting/invoices" class="btn">Cancel</a>
			</div>
		</form>
		@invoiceFormScript()
	}
}

func invoiceFormTitle(isNew bool, invoice *models.Invoice) string {
	if isNew {
		return "New Invoice"
	}
	return "Edit Invoice: " + invoice.InvoiceNumber
}

// atInput returns Alpine.js @input attribute as a templ.Attributes map.
func atInput() templ.Attributes {
	return templ.Attributes{"@input": "$el.name='q'"}
}

// invoiceForm is the Alpine.js data component for the invoice form. Customer
// selection is handled globally by atlinksSelectCustomer (see layout).
templ invoiceFormScript() {
	@templ.Raw(`<script>
function invoiceForm() {
    return {}
}
</script>`)
}
