package authpages

import "github.com/brady1408/auto-transport-logistics/internal/handler/components"

templ ResetPasswordPage(token string, errMsg string, tokenInvalid bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>ATLinks - Reset Password</title>
			<link rel="stylesheet" href={ components.AssetVersion("/static/css/app.css") }/>
		</head>
		<body class="login-body">
			<div class="login-container">
				<div class="login-card">
					<h1 class="login-title">Reset Password</h1>
					if errMsg != "" {
						<div class="alert alert-danger">{ errMsg }</div>
					}
					if tokenInvalid {
						<p style="text-align: center; margin-top: 1rem;">
							<a href="/forgot-password">Request a new reset link</a>
						</p>
					} else {
						<p class="login-subtitle">Choose a new password for your account.</p>
						<form method="POST" action={ templ.SafeURL("/reset-password/" + token) }>
							<div class="form-group">
								<label for="password">New Password</label>
								<input type="password" id="password" name="password" class="form-control" required autofocus/>
							</div>
							<div class="form-group">
								<label for="confirm_password">Confirm Password</label>
								<input type="password" id="confirm_password" name="confirm_password" class="form-control" required/>
							</div>
							<button type="submit" class="btn btn-primary btn-block">Reset Password</button>
						</form>
					}
					<p style="text-align: center; margin-top: 1rem;">
						<a href="/login">Back to Sign In</a>
					</p>
				</div>
			</div>
		</body>
	</html>
}
