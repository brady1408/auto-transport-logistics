package authpages

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
)

templ LoginPage(brand components.Brand, companyName string, loginAction string, username string, errMsg string, flash string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ brand.Name + " — " + brand.Tagline + ". Sign in to manage orders, trips, invoicing, and more." }/>
			if companyName != "" {
				<title>{ companyName } - Sign In</title>
			} else {
				<title>{ brand.Name } - { brand.Tagline }</title>
			}
			<link rel="icon" type="image/svg+xml" href={ brand.FaviconFile }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700;800&display=swap"/>
			<link rel="stylesheet" href={ components.AssetVersion("/static/css/app.css") }/>
		</head>
		<body class="login-body">
			if loginAction != "" {
				<!-- Company-specific login -->
				<div class="login-container">
					<div class="login-card">
						<h1 class="login-title">{ companyName }</h1>
						<p class="login-subtitle">{ brand.Tagline }</p>
						if flash != "" {
							<div class="alert alert-success">{ flash }</div>
						}
						if errMsg != "" {
							<div class="alert alert-danger">{ errMsg }</div>
						}
						<form method="POST" action={ templ.SafeURL(loginAction) }>
							<div class="form-group">
								<label for="username">Username</label>
								<input type="text" id="username" name="username" class="form-control" value={ username } required autofocus/>
							</div>
							<div class="form-group">
								<label for="password">Password</label>
								<input type="password" id="password" name="password" class="form-control" required/>
							</div>
							<button type="submit" class="btn btn-primary btn-block">Sign In</button>
						</form>
						<p style="text-align: center; margin-top: 0.75rem;">
							<a href="/forgot-password" style="font-size: 0.9rem;">Forgot Password?</a>
						</p>
					</div>
				</div>
			} else {
				<!-- Global login -->
				<div class="login-container">
					<div class="login-card">
						<h1 class="login-title">{ brand.Name }</h1>
						<p class="login-subtitle">{ brand.Tagline }</p>
						if flash != "" {
							<div class="alert alert-success">{ flash }</div>
						}
						if errMsg != "" {
							<div class="alert alert-danger">{ errMsg }</div>
						}
						<form method="POST" action="/login">
							<div class="form-group">
								<label for="login-username">Username</label>
								<input type="text" id="login-username" name="username" class="form-control" value={ username } required/>
							</div>
							<div class="form-group">
								<label for="login-password">Password</label>
								<input type="password" id="login-password" name="password" class="form-control" required/>
							</div>
							<button type="submit" class="btn btn-primary btn-block">Sign In</button>
						</form>
						<p style="text-align: center; margin-top: 0.75rem;">
							<a href="/forgot-password" style="font-size: 0.9rem;">Forgot Password?</a>
						</p>
						<p style="text-align: center; margin-top: 0.5rem; font-size: 0.85rem; color: var(--gray-400);">
							Don't have an account? <a href="/register" style="font-weight: 600;">Register</a>
						</p>
					</div>
				</div>
			}
		</body>
	</html>
}
