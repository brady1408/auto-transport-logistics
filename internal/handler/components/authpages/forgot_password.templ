package authpages

import "github.com/brady1408/auto-transport-logistics/internal/handler/components"

templ ForgotPasswordPage(errMsg string, success string, username string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>ATLinks - Forgot Password</title>
			<link rel="stylesheet" href={ components.AssetVersion("/static/css/app.css") }/>
		</head>
		<body class="login-body">
			<div class="login-container">
				<div class="login-card">
					<h1 class="login-title">Forgot Password</h1>
					<p class="login-subtitle">Enter your username and we'll send a reset link to the email on file.</p>
					if success != "" {
						<div class="alert alert-success">{ success }</div>
					}
					if errMsg != "" {
						<div class="alert alert-danger">{ errMsg }</div>
					}
					if success == "" {
						<form method="POST" action="/forgot-password">
							<div class="form-group">
								<label for="username">Username</label>
								<input type="text" id="username" name="username" class="form-control" value={ username } required autofocus/>
							</div>
							<button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
						</form>
					}
					<p style="text-align: center; margin-top: 1rem;">
						<a href="/login">Back to Sign In</a>
					</p>
					<p style="text-align: center; margin-top: 0.5rem; font-size: 0.85rem; color: #666;">
						Don't have an email on file? Contact your company admin to reset your password.
					</p>
				</div>
			</div>
		</body>
	</html>
}
