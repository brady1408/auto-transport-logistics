package charts

import "fmt"

// noDataPlaceholder renders a quiet, centered "No data yet" message used when a
// series is empty or entirely zero. Sized to loosely match the chart area.
templ noDataPlaceholder() {
	<div class="chart-empty" style="display:flex;align-items:center;justify-content:center;min-height:120px;color:#76777d;font-size:13px;">
		No data yet
	</div>
}

// ColumnChart renders a vertical bar/column chart with x-axis tick labels.
// Pass a prepared series; an empty or all-zero series shows "No data yet".
templ ColumnChart(data []Datum) {
	if !hasData(data) {
		@noDataPlaceholder()
	} else {
		{{ l := computeColumnLayout(data) }}
		<svg
			class="chart-svg"
			viewBox={ fmt.Sprintf("0 0 %.0f %.0f", l.Width, l.Height) }
			preserveAspectRatio="xMidYMid meet"
			role="img"
			style="width:100%;height:auto;display:block;font-family:'Inter',sans-serif;overflow:visible;"
		>
			<!-- baseline axis -->
			<line
				x1="0"
				y1={ fmt.Sprintf("%.1f", l.PlotBottom) }
				x2={ fmt.Sprintf("%.1f", l.Width) }
				y2={ fmt.Sprintf("%.1f", l.PlotBottom) }
				stroke="#c6c6cd"
				stroke-width="1"
			></line>
			for _, b := range l.Bars {
				<g>
					<title>{ b.Tip }</title>
					<rect
						x={ fmt.Sprintf("%.1f", b.X) }
						y={ fmt.Sprintf("%.1f", b.Y) }
						width={ fmt.Sprintf("%.1f", b.W) }
						height={ fmt.Sprintf("%.1f", b.H) }
						rx="2"
						fill={ b.Fill }
					></rect>
					<text
						x={ fmt.Sprintf("%.1f", b.LabelX) }
						y={ fmt.Sprintf("%.1f", l.PlotBottom+16) }
						text-anchor="middle"
						fill="#76777d"
						font-size="11"
						letter-spacing="0.04em"
						style="text-transform:uppercase;"
					>{ b.Label }</text>
				</g>
			}
		</svg>
	}
}

// HBarChart renders a horizontal bar chart: one row per datum with the label on
// the left, a proportional bar, and the value on the right. Good for ranked
// categories (e.g. top customers). Empty/zero series shows "No data yet".
templ HBarChart(data []Datum) {
	if !hasData(data) {
		@noDataPlaceholder()
	} else {
		{{ l := computeHBarLayout(data) }}
		<svg
			class="chart-svg"
			viewBox={ fmt.Sprintf("0 0 %.0f %.0f", l.Width, l.Height) }
			preserveAspectRatio="xMidYMid meet"
			role="img"
			style="width:100%;height:auto;display:block;font-family:'Inter',sans-serif;overflow:visible;"
		>
			for _, b := range l.Bars {
				<g>
					<title>{ b.Tip }</title>
					<!-- label -->
					<text
						x={ fmt.Sprintf("%.1f", l.LabelW) }
						y={ fmt.Sprintf("%.1f", b.Y+b.H*0.5) }
						text-anchor="end"
						dominant-baseline="middle"
						fill="#191c1e"
						font-size="12"
					>{ truncate(b.Label, 24) }</text>
					<!-- track -->
					<rect
						x={ fmt.Sprintf("%.1f", l.BarX) }
						y={ fmt.Sprintf("%.1f", b.Y) }
						width={ fmt.Sprintf("%.1f", l.Width-l.BarX-90-8) }
						height={ fmt.Sprintf("%.1f", b.H) }
						rx="2"
						fill="#eceef0"
					></rect>
					<!-- bar -->
					<rect
						x={ fmt.Sprintf("%.1f", l.BarX) }
						y={ fmt.Sprintf("%.1f", b.Y) }
						width={ fmt.Sprintf("%.1f", b.W) }
						height={ fmt.Sprintf("%.1f", b.H) }
						rx="2"
						fill={ b.Fill }
					></rect>
					<!-- value -->
					<text
						x={ fmt.Sprintf("%.1f", b.ValueX) }
						y={ fmt.Sprintf("%.1f", b.Y+b.H*0.5) }
						dominant-baseline="middle"
						fill="#45464d"
						font-size="11"
						font-weight="600"
					>{ b.Value }</text>
				</g>
			}
		</svg>
	}
}

// Sparkline renders a simple line + soft area for a small trend series.
templ Sparkline(data []Datum) {
	if !hasData(data) {
		@noDataPlaceholder()
	} else {
		{{ s := computeSparkline(data) }}
		<svg
			class="chart-svg"
			viewBox={ fmt.Sprintf("0 0 %.0f %.0f", s.Width, s.Height) }
			preserveAspectRatio="none"
			role="img"
			style="width:100%;height:auto;display:block;overflow:visible;"
		>
			<polygon points={ s.AreaPoints } fill="#497cff" fill-opacity="0.10"></polygon>
			<polyline
				points={ s.Points }
				fill="none"
				stroke="#497cff"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			></polyline>
			if s.HasDot {
				<circle cx={ fmt.Sprintf("%.1f", s.LastX) } cy={ fmt.Sprintf("%.1f", s.LastY) } r="2.5" fill="#00174b"></circle>
			}
		</svg>
	}
}
