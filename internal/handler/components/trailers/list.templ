package trailers

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ListPage(pg components.PageContext, result models.TrailerListResult, filter models.TrailerFilter) {
	@components.Layout(pg, "Trailers - ATLinks") {
		<div class="page-header">
			<h1>Trailers</h1>
			<a href="/global/trailers/new" class="btn btn-primary">New Trailer</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Trailer #, license, or make..."
					value={ filter.Search }
					hx-get="/global/trailers"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#trailer-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="active">Status</label>
				<select
					id="active" name="active" class="form-control"
					hx-get="/global/trailers"
					hx-trigger="change"
					hx-target="#trailer-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="">All</option>
					<option value="active" selected?={ filter.Active == "active" }>Active</option>
					<option value="inactive" selected?={ filter.Active == "inactive" }>Inactive</option>
				</select>
			</div>
		</div>
		<div id="trailer-table">
			@Table(result, filter)
		</div>
	}
}
