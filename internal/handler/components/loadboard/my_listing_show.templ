package loadboard

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ MyListingShowPage(pg components.PageContext, listing *models.LoadboardListing, vehicles []models.LoadboardListingVehicle, claims []models.LoadboardClaim) {
	@components.Layout(pg, listing.ListingNumber + " - My Listings - ATLinks") {
		<div class="page-header">
			<h1>{ listing.ListingNumber } — { listing.Title }</h1>
			<div class="btn-group">
				if listing.Status == "Posted" {
					<button
						class="btn btn-danger"
						hx-post={ fmt.Sprintf("/loadboard/my-listings/%d/cancel", listing.ID) }
						hx-confirm="Cancel this listing? Any pending claims will be rejected."
					>Cancel Listing</button>
				}
				<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/orders/%d", listing.SourceOrderID)) } class="btn">View Source Order</a>
				<a href="/loadboard/my-listings" class="btn">Back to My Listings</a>
			</div>
		</div>
		<div class="order-detail-grid">
			<div class="card">
				<div class="card-header">Listing Details</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Status:</span>
						<span>@statusBadge(listing.Status)</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Carrier Pay:</span>
						<span><strong>${ listing.CarrierPay }</strong></span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Vehicles:</span>
						<span>{ fmt.Sprintf("%d", listing.VehicleCount) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Mode:</span>
						<span>
							if listing.AutoAccept {
								<span class="badge badge-active">Instant Book</span>
							} else {
								<span class="badge badge-waiting">Requires Approval</span>
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Posted:</span>
						<span>{ listing.CreatedAt.Format("01/02/2006 3:04 PM") }</span>
					</div>
					if listing.ExpiresAt != nil {
						<div class="detail-row">
							<span class="detail-label">Expires:</span>
							<span>{ listing.ExpiresAt.Format("01/02/2006 3:04 PM") }</span>
						</div>
					}
				</div>
			</div>
			<div class="card">
				<div class="card-header">Route</div>
				<div class="card-body">
					<strong>Origin:</strong> { components.Deref(listing.OriginName) }
					if listing.OriginCity != nil {
						<br/>
						{ components.Deref(listing.OriginCity) }, { components.Deref(listing.OriginState) } { components.Deref(listing.OriginZip) }
					}
					<hr class="dropdown-divider"/>
					<strong>Destination:</strong> { components.Deref(listing.DestName) }
					if listing.DestCity != nil {
						<br/>
						{ components.Deref(listing.DestCity) }, { components.Deref(listing.DestState) } { components.Deref(listing.DestZip) }
					}
				</div>
			</div>
		</div>
		if listing.SpecialInstructions != nil && *listing.SpecialInstructions != "" {
			<div class="card" style="margin-top:1rem;">
				<div class="card-header">Special Instructions</div>
				<div class="card-body">{ components.Deref(listing.SpecialInstructions) }</div>
			</div>
		}
		<h2 class="section-title">Vehicles</h2>
		@vehicleTable(vehicles)
		<h2 class="section-title">Claims ({ fmt.Sprintf("%d", len(claims)) })</h2>
		if len(claims) > 0 {
			for _, c := range claims {
				<div class="card" style="margin-bottom:1rem;">
					<div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
						<span>
							<strong>{ components.Deref(c.CarrierCompanyName) }</strong>
							if c.CarrierSCAC != nil {
								<span class="text-muted"> · SCAC: { components.Deref(c.CarrierSCAC) }</span>
							}
							if c.CarrierMCNumber != nil {
								<span class="text-muted"> · MC#: { components.Deref(c.CarrierMCNumber) }</span>
							}
						</span>
						<span>
							@statusBadge(c.Status)
						</span>
					</div>
					<div class="card-body">
						<div style="display:flex; gap:2rem; flex-wrap:wrap; margin-bottom:0.75rem;">
							<div>
								<span class="detail-label">Agreed Pay:</span> <strong>${ c.AgreedPay }</strong>
							</div>
							<div>
								<span class="detail-label">Submitted:</span> { c.CreatedAt.Format("01/02/2006 3:04 PM") }
							</div>
							if c.CarrierDOTNumber != nil {
								<div>
									<span class="detail-label">DOT#:</span> { components.Deref(c.CarrierDOTNumber) }
								</div>
							}
							if c.CarrierNotes != nil {
								<div>
									<span class="detail-label">Carrier Notes:</span> { components.Deref(c.CarrierNotes) }
								</div>
							}
						</div>
						<div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:1rem;">
							if c.Status == "Pending" {
								<button
									class="btn btn-sm btn-primary"
									hx-post={ fmt.Sprintf("/loadboard/claims/%d/accept", c.ID) }
									hx-confirm="Accept this claim? An order will be imported to the carrier's system."
								>Accept</button>
								<button
									class="btn btn-sm btn-danger"
									hx-post={ fmt.Sprintf("/loadboard/claims/%d/reject", c.ID) }
									hx-confirm="Reject this claim?"
								>Reject</button>
							}
							if c.CarrierOrderID != nil {
								<span class="text-muted">Order imported</span>
							}
						</div>
						<!-- Messages section, lazy-loaded via HTMX -->
						<div
							id={ fmt.Sprintf("claim-messages-%d", c.ID) }
							hx-get={ fmt.Sprintf("/loadboard/claims/%d/messages", c.ID) }
							hx-trigger="revealed"
							hx-swap="innerHTML"
						>
							<p class="text-muted">
								if c.MessageCount > 0 {
									Loading { fmt.Sprintf("%d", c.MessageCount) } messages...
								} else {
									No messages yet.
								}
							</p>
						</div>
					</div>
				</div>
			}
		} else {
			<div class="card">
				<div class="card-body text-center text-muted">No claims yet</div>
			</div>
		}
	}
}
