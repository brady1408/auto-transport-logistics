package loadboard

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ BrowsePage(pg components.PageContext, result models.LoadboardListResult, filter models.LoadboardFilter) {
	@components.Layout(pg, "Loadboard - ATLinks") {
		<div class="page-header">
			<h1>Loadboard</h1>
			<div class="btn-group">
				<a href="/loadboard/my-listings" class="btn">My Listings</a>
				<a href="/loadboard/my-claims" class="btn">My Claims</a>
			</div>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Title, listing #, city, company..."
					value={ filter.Search }
					hx-get="/loadboard"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#loadboard-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="origin_state">Origin State</label>
				<input
					type="text" id="origin_state" name="origin_state" class="form-control"
					placeholder="e.g. CA"
					maxlength="2"
					style="width:80px;"
					value={ filter.OriginState }
					hx-get="/loadboard"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#loadboard-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="dest_state">Dest State</label>
				<input
					type="text" id="dest_state" name="dest_state" class="form-control"
					placeholder="e.g. TX"
					maxlength="2"
					style="width:80px;"
					value={ filter.DestState }
					hx-get="/loadboard"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#loadboard-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="min_pay">Min Pay</label>
				<input
					type="number" id="min_pay" name="min_pay" class="form-control"
					placeholder="$"
					style="width:100px;"
					value={ filter.MinPay }
					hx-get="/loadboard"
					hx-trigger="change"
					hx-target="#loadboard-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="max_pay">Max Pay</label>
				<input
					type="number" id="max_pay" name="max_pay" class="form-control"
					placeholder="$"
					style="width:100px;"
					value={ filter.MaxPay }
					hx-get="/loadboard"
					hx-trigger="change"
					hx-target="#loadboard-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
		</div>
		@MapContainer()
		@ViewTabs(result)
	}
}
