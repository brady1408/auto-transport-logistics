package ap

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ShowPage(pg components.PageContext, apRecord *models.AccountsPayable) {
	@components.Layout(pg, fmt.Sprintf("AP #%d - ATLinks", apRecord.ID)) {
		<div class="page-header">
			<div>
				<a href="/accounting/ap" class="page-header-back">← Back to List</a>
				<h1>Accounts Payable #{ fmt.Sprintf("%d", apRecord.ID) }</h1>
			</div>
			<div class="btn-group">
				<a href={ templ.SafeURL(fmt.Sprintf("/accounting/ap/%d/edit", apRecord.ID)) } class="btn">Edit</a>
				<button
					class="btn btn-danger"
					hx-delete={ fmt.Sprintf("/accounting/ap/%d", apRecord.ID) }
					hx-confirm="Delete this AP record?"
				>Delete</button>
			</div>
		</div>
		<div class="order-detail-grid">
			<div class="card">
				<div class="card-header">AP Info</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Vendor:</span>
						<span>{ components.Deref(apRecord.VendorName) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Status:</span>
						<span>
							@apStatusBadge(apRecord.Status)
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Date:</span>
						<span>
							if apRecord.PayableDate != nil {
								{ apRecord.PayableDate.Format("01/02/2006") }
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Amount:</span>
						<span><strong>${ components.Deref(apRecord.Amount) }</strong></span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Paid Amount:</span>
						<span>${ components.Deref(apRecord.PaidAmount) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Description:</span>
						<span>{ components.Deref(apRecord.Description) }</span>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">References &amp; Check</div>
				<div class="card-body">
					<div class="detail-row">
						<span class="detail-label">Trip:</span>
						<span>
							if apRecord.TripID != nil {
								<a href={ templ.SafeURL(fmt.Sprintf("/dispatch/trips/%d", components.DerefInt(apRecord.TripID))) }>Trip #{ fmt.Sprintf("%d", components.DerefInt(apRecord.TripID)) }</a>
							}
						</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Employee ID:</span>
						<span>{ fmt.Sprintf("%d", components.DerefInt(apRecord.EmployeeID)) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Truck ID:</span>
						<span>{ fmt.Sprintf("%d", components.DerefInt(apRecord.TruckID)) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Check #:</span>
						<span>{ components.Deref(apRecord.CheckNumber) }</span>
					</div>
					<div class="detail-row">
						<span class="detail-label">Check Date:</span>
						<span>
							if apRecord.CheckDate != nil {
								{ apRecord.CheckDate.Format("01/02/2006") }
							}
						</span>
					</div>
				</div>
			</div>
		</div>
		if apRecord.Comments != nil {
			<h2 class="section-title">Comments</h2>
			<div class="card">
				<div class="card-body">{ components.Deref(apRecord.Comments) }</div>
			</div>
		}
	}
}
