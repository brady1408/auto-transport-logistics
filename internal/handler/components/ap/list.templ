package ap

import (
	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ListPage(pg components.PageContext, result models.APListResult, filter models.APFilter) {
	@components.Layout(pg, "Accounts Payable - ATLinks") {
		<div class="page-header">
			<h1>Accounts Payable</h1>
			<a href="/accounting/ap/new" class="btn btn-primary">New AP</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Vendor, description, check #..."
					value={ filter.Search }
					hx-get="/accounting/ap"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#ap-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="status">Status</label>
				<select
					id="status" name="status" class="form-control"
					hx-get="/accounting/ap"
					hx-trigger="change"
					hx-target="#ap-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				>
					<option value="" selected?={ filter.Status == "" }>All</option>
					<option value="Open" selected?={ filter.Status == "Open" }>Open</option>
					<option value="Pending" selected?={ filter.Status == "Pending" }>Pending</option>
					<option value="Paid" selected?={ filter.Status == "Paid" }>Paid</option>
				</select>
			</div>
		</div>
		<div id="ap-table">
			@Table(result)
		</div>
	}
}
