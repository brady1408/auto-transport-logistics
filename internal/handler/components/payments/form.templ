package payments

import (
	"fmt"

	"github.com/brady1408/atlinks/internal/handler/components"
	"github.com/brady1408/atlinks/internal/models"
)

templ FormPage(pg components.PageContext, payment *models.Payment, isNew bool, errMsg string) {
	@components.Layout(pg, paymentFormTitle(isNew, payment) + " - ATLinks") {
		<div class="page-header">
			<h1>
				if isNew {
					New Payment
				} else {
					Edit Payment #{ fmt.Sprintf("%d", payment.ID) }
				}
			</h1>
			<a href="/accounting/payments" class="btn">Back to List</a>
		</div>
		if errMsg != "" {
			<div class="alert alert-danger">{ errMsg }</div>
		}
		<form
			method="POST"
			if isNew {
				action="/accounting/payments"
				hx-post="/accounting/payments"
			} else {
				action={ templ.SafeURL(fmt.Sprintf("/accounting/payments/%d/edit", payment.ID)) }
				hx-put={ fmt.Sprintf("/accounting/payments/%d", payment.ID) }
			}
			x-data="paymentForm()"
		>
			<fieldset>
				<legend>Payment Information</legend>
				<div class="form-row">
					<div class="form-group">
						<label for="payment_date">Payment Date</label>
						<input type="date" id="payment_date" name="payment_date" class="form-control" value={ components.FormatDate(payment.PaymentDate) }/>
					</div>
					<div class="form-group">
						<label for="amount">Amount</label>
						<input type="text" id="amount" name="amount" class="form-control" value={ components.Deref(payment.Amount) }/>
					</div>
					<div class="form-group">
						<label for="payment_method">Method</label>
						<select id="payment_method" name="payment_method" class="form-control">
							<option value="">--</option>
							<option value="Check" selected?={ components.Deref(payment.PaymentMethod) == "Check" }>Check</option>
							<option value="ACH" selected?={ components.Deref(payment.PaymentMethod) == "ACH" }>ACH</option>
							<option value="Wire" selected?={ components.Deref(payment.PaymentMethod) == "Wire" }>Wire</option>
							<option value="Cash" selected?={ components.Deref(payment.PaymentMethod) == "Cash" }>Cash</option>
							<option value="Card" selected?={ components.Deref(payment.PaymentMethod) == "Card" }>Card</option>
						</select>
					</div>
					<div class="form-group">
						<label for="check_number">Check #</label>
						<input type="text" id="check_number" name="check_number" class="form-control" value={ components.Deref(payment.CheckNumber) } maxlength="20"/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Customer</legend>
				<div class="form-row">
					<div class="form-group" style="grid-column: span 2;">
						<label for="pay_customer_search">Search Customer</label>
						<input
							type="text" id="pay_customer_search" class="form-control"
							placeholder="Type to search..."
							hx-get="/api/customers/search"
							hx-trigger="keyup changed delay:300ms"
							hx-target="#pay_customer_results"
							hx-params="*"
							{ atInput()... }
						/>
						<div id="pay_customer_results" class="search-results"></div>
						<input type="hidden" id="customer_id" name="customer_id" value={ fmt.Sprintf("%d", components.DerefInt(payment.CustomerID)) }/>
					</div>
					<div class="form-group">
						<label for="customer_number">Customer #</label>
						<input type="text" id="customer_number" name="customer_number" class="form-control" value={ components.Deref(payment.CustomerNumber) } maxlength="10"/>
					</div>
					<div class="form-group">
						<label for="customer_name">Name</label>
						<input type="text" id="customer_name" name="customer_name" class="form-control" value={ components.Deref(payment.CustomerName) } maxlength="30"/>
					</div>
				</div>
			</fieldset>
			<fieldset>
				<legend>Comments</legend>
				<div class="form-group">
					<textarea id="comments" name="comments" class="form-control">{ components.Deref(payment.Comments) }</textarea>
				</div>
			</fieldset>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					if isNew {
						Create Payment
					} else {
						Save Changes
					}
				</button>
				<a href="/accounting/payments" class="btn">Cancel</a>
			</div>
		</form>
		@paymentFormScript()
	}
}

func paymentFormTitle(isNew bool, payment *models.Payment) string {
	if isNew {
		return "New Payment"
	}
	return fmt.Sprintf("Edit Payment #%d", payment.ID)
}

// atInput returns Alpine.js @input attribute as a templ.Attributes map.
func atInput() templ.Attributes {
	return templ.Attributes{"@input": "$el.name='q'"}
}

templ paymentFormScript() {
	@templ.Raw(`<script>
function paymentForm() {
    return {
        selectCustomer(prefix, customer) {
            document.getElementById('customer_id').value = customer.id;
            document.getElementById('customer_number').value = customer.number || '';
            document.getElementById('customer_name').value = customer.name || '';
        }
    }
}
</script>`)
}
