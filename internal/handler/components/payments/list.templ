package payments

import (
	"fmt"

	"github.com/brady1408/auto-transport-logistics/internal/handler/components"
	"github.com/brady1408/auto-transport-logistics/internal/models"
)

templ ListPage(pg components.PageContext, result models.PaymentListResult, filter models.PaymentFilter) {
	@components.Layout(pg, "Payments - ATLinks") {
		<div class="page-header">
			<h1>Payments</h1>
			<a href={ templ.SafeURL(fmt.Sprintf("/accounting/payments/export/qbo.csv?date_from=%s&date_to=%s", filter.DateFrom, filter.DateTo)) } class="btn" title="Download a Receive Payments CSV for third-party QuickBooks importers">QuickBooks CSV</a>
			<a href="/accounting/payments/new" class="btn btn-primary">New Payment</a>
		</div>
		<div class="filter-bar">
			<div class="form-group">
				<label for="search">Search</label>
				<input
					type="text" id="search" name="search" class="form-control search-input"
					placeholder="Customer, check #..."
					value={ filter.Search }
					hx-get="/accounting/payments"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#payment-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="date_from">From</label>
				<input
					type="date" id="date_from" name="date_from" class="form-control"
					value={ filter.DateFrom }
					hx-get="/accounting/payments"
					hx-trigger="change"
					hx-target="#payment-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<div class="form-group">
				<label for="date_to">To</label>
				<input
					type="date" id="date_to" name="date_to" class="form-control"
					value={ filter.DateTo }
					hx-get="/accounting/payments"
					hx-trigger="change"
					hx-target="#payment-table"
					hx-include=".filter-bar [name]"
					hx-push-url="true"
				/>
			</div>
			<input type="hidden" name="sort_by" value={ filter.SortBy }/>
			<input type="hidden" name="sort_dir" value={ filter.SortDir }/>
		</div>
		<div id="payment-table">
			@Table(result, filter)
		</div>
	}
}
